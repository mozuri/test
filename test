-- EXECUTOR COMPAT (Xeno / low-level support)
-------------------------------------------------
-- High-level executors have gethui/file funcs/Drawing/hook funcs/Font API.
-- Xeno and other cheap executors miss most of these, so detect once and
-- degrade gracefully instead of erroring mid-script (which was breaking
-- features + making the UI fall apart).
local HAS_HUI = typeof(gethui) == "function"
local HAS_FILES = typeof(isfile) == "function" and typeof(writefile) == "function" and typeof(readfile) == "function"
local HAS_FOLDERS = typeof(isfolder) == "function" and typeof(makefolder) == "function" and typeof(listfiles) == "function"
local HAS_CUSTOMASSET = typeof(getcustomasset) == "function"
local HAS_FONTAPI = typeof(Font) == "table" and typeof(Font.fromEnum) == "function"
local HAS_DRAWING = typeof(Drawing) == "table" and typeof(Drawing.new) == "function"
local HAS_HOOKS = typeof(getrawmetatable) == "function" and typeof(hookfunction) == "function"
    and typeof(newcclosure) == "function" and typeof(checkcaller) == "function"

-- Parent a ScreenGui safely: gethui() can THROW on Xeno even when it exists,
-- so never call it unprotected. Fall back to PlayerGui, then CoreGui.
local function SafeParentGui(gui)
    if HAS_HUI then
        local ok, h = pcall(gethui)
        if ok and h then
            local ok2 = pcall(function() gui.Parent = h end)
            if ok2 and gui.Parent then return true end
        end
    end
    local okp, pg = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 10) end)
    if okp and pg then
        local ok3 = pcall(function() gui.Parent = pg end)
        if ok3 and gui.Parent then return true end
    end
    local ok4 = pcall(function() gui.Parent = CoreGui end)
    if ok4 and gui.Parent then return true end
    return false
end

