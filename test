    local rightFlat = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    if rightFlat.Magnitude > 0.001 then rightFlat = rightFlat.Unit end

    local arrowIndex = 0

    for _, player in ipairs(Players:GetPlayers()) do
