local function HoodApplySkin(Tool, weaponNameFromTool, SkinName)
    local Handle = Tool:FindFirstChild('Handle')
    if not Handle then return end

    local Tag = Handle:FindFirstChild('SkinTag')
    if Tag and Tag.Value == SkinName then return end

    if not Handle:GetAttribute('OrigTexture') then
        Handle:SetAttribute('OrigTexture', Handle.TextureID)
        Handle:SetAttribute('OrigColor', Handle.Color)
        Handle:SetAttribute('OrigMaterial', Handle.Material.Value)
        Handle:SetAttribute('OrigTransparency', Handle.Transparency)
    end

    HoodClearAdded(Handle)

    if not Tag then
        Tag = Instance.new('StringValue')
        Tag.Name = 'SkinTag'
        Tag.Parent = Handle
    end
    Tag.Value = SkinName

    -- Original hood customs skin logic - exactly like the working reference
    local WrapGun = ReplicatedStorage:FindFirstChild('Wraps')
    if not WrapGun then return end
    
    local GunFolder = WrapGun:FindFirstChild("[" .. weaponNameFromTool .. "]")
    if not GunFolder then return end
    
    local Wrap = GunFolder:FindFirstChild(SkinName)
    if not Wrap then return end

    local WrapClone = Wrap:Clone()
    local WrapHandle = WrapClone:FindFirstChild('Handle')
    if not WrapHandle then WrapClone:Destroy() return end

    local BaseCF = WrapHandle.CFrame

    for _, Obj in WrapHandle:GetChildren() do
        if Obj:IsA('Sound') or Obj:IsA('BillboardGui') then continue end

        if Obj:IsA('BasePart') then
            local Offset = BaseCF:ToObjectSpace(Obj.CFrame)
            Obj.Anchored = false
            Obj.CanCollide = false
            Obj.Massless = true
            Obj.CFrame = Handle.CFrame * Offset

            for _, W in Obj:GetChildren() do
                if W:IsA('Weld') or W:IsA('WeldConstraint') then W:Destroy() end
            end

            local Weld = Instance.new('Weld')
            Weld.Name = 'SkinWeld'
            Weld.Part0 = Handle
            Weld.Part1 = Obj
            Weld.C0 = Offset
            Weld:SetAttribute('SkinClone', true)
            Weld.Parent = Obj
        end

        Obj:SetAttribute('SkinClone', true)
        Obj.Parent = Handle
    end

    Handle.TextureID = WrapHandle.TextureID
    Handle.Color = WrapHandle.Color
    Handle.Material = WrapHandle.Material
    Handle.Transparency = WrapHandle.Transparency
    WrapClone:Destroy()
end

local function HoodRestoreSkin(Tool)
