local MATERIALS = {
    Mud = Enum.Material.Mud, Neon = Enum.Material.Neon, Rock = Enum.Material.Rock,
    Brick = Enum.Material.Brick, Sand = Enum.Material.Sand, Ice = Enum.Material.Ice, ForceField = Enum.Material.ForceField
}

local originalMaterials = {}

local function getSkipSet()
    local skip = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then skip[p.Character] = true end
    end
    skip[Workspace.CurrentCamera] = true
    return skip
end

local function isMapPart(part, skipSet)
    if not part:IsA("BasePart") then return false end
    local a = part.Parent
    while a and a ~= Workspace do
        if skipSet[a] then return false end
        if a.Name == "Players" or a.Name == "Camera" or a.Name == "Terrain" then return false end
        a = a.Parent
    end
    return part:IsDescendantOf(Workspace)
end

local lastTextureMat = nil
RunService.Heartbeat:Connect(function()
    if getgenv().WorldConfig.TextureEnable == true then
        local sel = tostring(getgenv().WorldConfig.Texture or "ForceField")
        local mat = MATERIALS[sel]
        if mat and lastTextureMat ~= sel then
            lastTextureMat = sel
            local skip = getSkipSet()
            for _, part in ipairs(Workspace:GetDescendants()) do
                if isMapPart(part, skip) then
                    if not originalMaterials[part] then
                        originalMaterials[part] = part.Material
                    end
                    part.Material = mat
                end
            end
        end
    else
        if lastTextureMat ~= nil then
            lastTextureMat = nil
            for part, origMat in pairs(originalMaterials) do
                if part and part.Parent then
                    pcall(function() part.Material = origMat end)
                end
            end
            originalMaterials = {}
        end
    end
end)

Workspace.DescendantAdded:Connect(function(part)
