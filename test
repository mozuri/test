local function findChildNorm(parent, name)
    if not parent then return nil end
    local ex = parent:FindFirstChild(name)
    if ex then return ex end
    local n = norm(name)
    for _, c in ipairs(parent:GetChildren()) do
        if norm(c.Name) == n then return c end
    end
    local v1 = parent:FindFirstChild(name:gsub("-", " "))
    if v1 then return v1 end
    local v2 = parent:FindFirstChild(name:gsub("-", ""))
    if v2 then return v2 end
    return nil
end

-- Xeno fallback mesh scan: Xeno's require() cannot read SkinModules, so
-- getGunInfo() finds nothing there and skins fall back to retexturing the
-- default mesh (the Shadow model never appears). When the DB lookup fails,
-- locate the base skin mesh (e.g. "Shadow") directly in ReplicatedStorage.
local BaseMeshCache = {}
local ScanWarned = {}

local function weaponToken(toolName)
    local tnorm = norm(toolName)
    for _, t in ipairs({ "doublebarrel", "tacticalshotgun", "revolver", "shotgun", "smg" }) do
        if tnorm:find(t, 1, true) then return t end
    end
    return tnorm
end

-- Only accept meshes that would actually render: rejects empty folders and
-- fully-transparent parts (these made guns turn invisible with no error).
local function hasRenderableParts(inst)
    local ok, res = pcall(function()
        if inst:IsA("MeshPart") then
            return inst.Transparency < 1
        end
        if inst:IsA("Model") or inst:IsA("Folder") then
            for _, d in ipairs(inst:GetDescendants()) do
                if d:IsA("BasePart") and d.Transparency < 1 then return true end
            end
        end
        return false
    end)
    if ok then return res end
    return true
end

local function weaponFolderScore(inst, token)
    local a, depth = inst.Parent, 0
    while a and depth <= 12 do
        if a == ReplicatedStorage then break end
        local an = ""
        pcall(function() an = norm(a.Name) end)
        if an ~= "" and (an:find(token, 1, true) or token:find(an, 1, true)) then
            return 100 - depth
        end
        a = a.Parent
        depth = depth + 1
    end
    return 0
end

local function scanWarnOnce(key, msg)
    if ScanWarned[key] then return end
    ScanWarned[key] = true
    warn("Celestite skins scan [" .. key .. "]: " .. msg)
end

local function findBaseMeshInstance(toolName, baseSkin)
    local key = tostring(toolName) .. "|" .. tostring(baseSkin)
    local cached = BaseMeshCache[key]
    if cached ~= nil then
        if cached == false then return nil end
        if typeof(cached) == "Instance" and cached.Parent then return cached end
        BaseMeshCache[key] = nil
    end
    local want = norm(baseSkin)
    if want == "" then BaseMeshCache[key] = false return nil end
    local token = weaponToken(toolName)
    -- Fast path: Wraps (same source Hood Customs uses, proven on Xeno).
    local okW, wraps = pcall(function() return ReplicatedStorage:FindFirstChild("Wraps") end)
    if okW and wraps then
        local okCh, children = pcall(function() return wraps:GetChildren() end)
        if okCh and children then
            for _, wf in ipairs(children) do
                local wn = ""
                pcall(function() wn = norm(wf.Name) end)
                if wn ~= "" and (wn:find(token, 1, true) or token:find(wn, 1, true)) then
                    local hit = findChildNorm(wf, baseSkin)
                    if hit and typeof(hit) == "Instance"
                        and (hit:IsA("MeshPart") or hit:IsA("Model") or hit:IsA("Folder"))
                        and hasRenderableParts(hit) then
                        BaseMeshCache[key] = hit
                        scanWarnOnce(key, "Wraps pick -> " .. wf:GetFullName() .. "." .. hit.Name)
                        return hit
                    end
                end
            end
        end
    end
    -- Deep scan with geometry validation.
    local ok, descendants = pcall(function() return ReplicatedStorage:GetDescendants() end)
    if not ok or type(descendants) ~= "table" then BaseMeshCache[key] = false return nil end
    local bestAny, bestWeapon, bestScore = nil, nil, -1
    for _, d in ipairs(descendants) do
        local cn = nil
        pcall(function() cn = d.ClassName end)
        if (cn == "MeshPart" or cn == "Model" or cn == "Folder") and norm(d.Name) == want then
            if hasRenderableParts(d) then
                if not bestAny then bestAny = d end
                local score = weaponFolderScore(d, token)
                if score > bestScore then bestWeapon, bestScore = d, score end
                if bestScore and bestScore >= 100 then break end
            end
        end
    end
    local pick = nil
    if bestScore and bestScore > 0 then pick = bestWeapon end
    if not pick then pick = bestAny end
    if pick and typeof(pick) == "Instance" then
        BaseMeshCache[key] = pick
        scanWarnOnce(key, "scan pick -> " .. tostring(pick:GetFullName()))
        return pick
    end
    -- MISS: list what IS available so the next fix is certain (one-time).
    local hint = ""
    pcall(function()
        local w2 = ReplicatedStorage:FindFirstChild("Wraps")
        local names = {}
        if w2 then
            for i, c in ipairs(w2:GetChildren()) do
                if i > 25 then break end
                names[#names + 1] = c.Name
            end
            hint = "Wraps children: " .. table.concat(names, ", ")
        else
            hint = "no Wraps folder in ReplicatedStorage"
        end
    end)
    BaseMeshCache[key] = false
    scanWarnOnce(key, "MISS, no usable '" .. tostring(baseSkin) .. "' mesh. " .. hint)
    return nil
end

local function getGunInfo(weaponName, skinName)
    local db = skinDB()
    if db then
        local w = db[weaponName]
        if w and w[skinName] then return w[skinName] end
        if w then
            local n = norm(skinName)
            for k, v in pairs(w) do
                if norm(k) == n then return v end
            end
        end
    end
    -- Mesh scan BEFORE the string cross-weapon fallback: an actual Shadow
    -- model instance is what the clone code needs (strings can't be cloned).
    -- This is what makes Shadow models appear on Xeno.
    local inst = findBaseMeshInstance(weaponName, skinName)
    if inst then return { TextureID = inst, CFrame = nil, Scanned = true } end
    if db then
        local n2 = norm(skinName)
        for _, wtbl in pairs(db) do
            if type(wtbl) == "table" then
                for k, v in pairs(wtbl) do
                    if norm(k) == n2 and v and v.TextureID and type(v.TextureID) == "string" then
                        return { TextureID = v.TextureID, CFrame = nil, CrossWeapon = true }
                    end
                end
            end
        end
    end
    return nil
end

local function defaultMesh(tool)
    local d = tool:FindFirstChild("Default")
    if d and d:IsA("MeshPart") then return d end
    if d and d:IsA("BasePart") then return d end
    local m = tool:FindFirstChildOfClass("MeshPart")
    if m then return m end
    local h = tool:FindFirstChild("Handle")
    if h and h:IsA("MeshPart") then return h end
    return nil
end

local function cleanCustomGun(tool)
    -- Xeno can hand us a non-Instance here (see applyCustomGun note):
    -- bail quietly instead of throwing.
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
        pcall(function() CustomGunState[tool] = nil end)
        return
    end
    local st = CustomGunState[tool]
    if st then
        if st.conns then for _, c in ipairs(st.conns) do pcall(function() c:Disconnect() end) end end
        if st.clones then for _, v in ipairs(st.clones) do if v and v.Parent then pcall(function() v:Destroy() end) end end end
        local def = defaultMesh(tool)
        if def and st.origTexture ~= nil then pcall(function() def.TextureID = st.origTexture end) end
        if def and st.origTrans ~= nil then pcall(function() def.Transparency = st.origTrans end) end
        if def and st.origColor ~= nil then pcall(function() def.Color = st.origColor end) end
        if st.handle and st.handle.Parent then
            for _, v in ipairs(st.handle:GetChildren()) do
                if v:GetAttribute("_vanilla") then pcall(function() v:Destroy() end) end
            end
            if st.origSkinName ~= nil then pcall(function() st.handle:SetAttribute("SkinName", st.origSkinName) end) end
        end
        if st.shoot and st.shoot.Parent and st.origShootId then
            pcall(function() st.shoot.SoundId = st.origShootId end)
        end
        if st.solidParts then
            for part, bak in pairs(st.solidParts) do
                pcall(function()
                    if part and part.Parent then
                        if bak.Color then part.Color = bak.Color end
                        if bak.Material then part.Material = bak.Material end
                    end
                end)
            end
        end
        if st.solidSA then
            for sa, bak in pairs(st.solidSA) do
                pcall(function()
                    if sa and sa.Parent and bak.ColorMap ~= nil then
                        sa.ColorMap = bak.ColorMap
                    end
                end)
            end
        end
        CustomGunState[tool] = nil
    end
    for _, v in ipairs(tool:GetChildren()) do
        if v:GetAttribute("_vanilla") then pcall(function() v:Destroy() end) end
        if v.Name == "CurrentSkin" then pcall(function() v:Destroy() end) end
    end
end

local function applyCustomGun(tool, skinName)
    -- HARD GUARDS (Xeno fix): on low-level executors `tool` has been observed
    -- arriving as a table, which made `clone.Parent = tool` throw
    -- "invalid argument #3 (Instance expected, got table)" and killed the
    -- whole skin feature. Validate everything up front and bail quietly.
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then return end
    if type(skinName) ~= "string" then return end
    if not skinName or skinName == "" or skinName == "Default" or skinName == "None" then
        cleanCustomGun(tool)
        local def = defaultMesh(tool)
        if def then pcall(function() def.Transparency = 0 end) end
        return
    end

    local def = defaultMesh(tool)
    if not def or typeof(def) ~= "Instance" or not def:IsA("BasePart") then return end

    local custom = getCustomDef(tool.Name, skinName)

    if not custom then return end
    cleanCustomGun(tool)

    local st = { clones = {}, conns = {}, skin = skinName }
    CustomGunState[tool] = st
    st.origTexture = def.TextureID
    st.origTrans = def.Transparency
    st.origColor = def.Color

    local handle = tool:FindFirstChild("Handle")
    st.handle = handle
    if handle then
        st.origSkinName = handle:GetAttribute("SkinName") or ""
    end
    local shoot = nil
    if handle then shoot = handle:FindFirstChild("ShootSound") or handle:FindFirstChild("Shoot") end
    if not shoot then
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("Sound") and (d.Name == "ShootSound" or d.Name == "Shoot") then shoot = d break end
        end
    end
    st.shoot = shoot
    if shoot then st.origShootId = shoot.SoundId end

    local base = custom.Base or "Shadow"
    local neon = CUSTOM_BULLETS[skinName] or Color3.fromRGB(255, 255, 255)
    if skinName == "Cosmic" then
        neon = Color3.fromRGB(130, 90, 255)
    end
    local tinted = {}

    local function tintPart(p)
        pcall(function()
            p.Color = neon
            if p.Name:lower() == "neon" then
                p.Material = Enum.Material.Neon
            end
        end)
        table.insert(tinted, p)
    end

    local function tintInside(container)
        if container:IsA("BasePart") and (container.Name:lower() == "neon" or container.Name:lower() == "default") then
            tintPart(container)
        end
        for _, d in ipairs(container:GetDescendants()) do
            if d:IsA("BasePart") and (d.Name:lower() == "neon" or d.Name:lower() == "default") then
                tintPart(d)
            end
        end
    end
    
    local function tintPart(p)
        pcall(function()
            p.Color = neon
            if p.Name:lower() == "neon" then
                p.Material = Enum.Material.Neon
            end
        end)
        table.insert(tinted, p)
    end
    
    local function tintInside(container)
        if container:IsA("BasePart") and (container.Name:lower() == "neon" or container.Name:lower() == "default") then
            tintPart(container)
        end
        for _, d in ipairs(container:GetDescendants()) do
            if d:IsA("BasePart") and (d.Name:lower() == "neon" or d.Name:lower() == "default") then
                tintPart(d)
            end
        end
    end
    
    local function animateTinted()
        local isRGB = custom.RGB == true
        if skinName ~= "Cosmic" and not isRGB then return end
        local conn
        conn = RunService.Heartbeat:Connect(function()
            local c
            if isRGB then
                c = Color3.fromHSV((tick() * 0.15) % 1, 1, 1)
            else
                local t = (math.sin(tick() * 2.2) + 1) / 2
                c = Color3.fromHSV(0.58 + 0.22 * t, 1, 1)
            end
            local BLACK = Color3.fromRGB(0, 0, 0)
            local function rgbColorForPart(p)
                if isRGB then
                    local okN, nm = pcall(function() return p.Name:lower() end)
                    if okN and nm == "neon" then return BLACK end
                end
                return c
            end
            local function rgbMaterialForPart(p)
                if isRGB then
                    local okN2, nm2 = pcall(function() return p.Name:lower() end)
                    if okN2 and nm2 == "neon" then return Enum.Material.SmoothPlastic end
                    return Enum.Material.Neon
                end
                return nil
            end
            for _, p in ipairs(tinted) do
                if p.Parent then
                    pcall(function()
                        p.Color = rgbColorForPart(p)
                        if isRGB and p:IsA("BasePart") then
                            p.Material = rgbMaterialForPart(p)
                        end
                    end)
                end
            end
            if isRGB then
                pcall(function()
                    for _, v in ipairs(st.clones) do
                        if typeof(v) == "Instance" and v.Parent then
                            if v:IsA("BasePart") then
                                v.Color = rgbColorForPart(v)
                                v.Material = rgbMaterialForPart(v)
                            elseif v:IsA("Model") or v:IsA("Folder") then
                                for _, d in ipairs(v:GetDescendants()) do
                                    if d:IsA("BasePart") then
                                        d.Color = rgbColorForPart(d)
                                        d.Material = rgbMaterialForPart(d)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            if #tinted == 0 then pcall(function() conn:Disconnect() end) end
        end)
        table.insert(st.conns, conn)
    end
    
    if base == "Normal" then
        if custom.Solid then
            st.solidParts = {}
            st.solidSA = {}
            local function solidTint(p)
                if p:IsA("BasePart") then
                    if st.solidParts[p] == nil then
                        local okC, c = pcall(function() return p.Color end)
                        local okM, m = pcall(function() return p.Material end)
                        st.solidParts[p] = {
                            Color = okC and c or nil,
                            Material = okM and m or nil,
                        }
                    end
                    pcall(function()
                        p.Color = neon
                        p.Material = Enum.Material.SmoothPlastic
                        if p:IsA("MeshPart") and p.TextureID ~= "" then
                            p.TextureID = ""
                        end
                    end)
                    table.insert(tinted, p)
                elseif p:IsA("SurfaceAppearance") then
                    if st.solidSA[p] == nil then
                        local okCM, cm = pcall(function() return p.ColorMap end)
                        st.solidSA[p] = { ColorMap = okCM and cm or nil }
                    end
                    pcall(function() p.ColorMap = "" end)
                elseif p:IsA("MeshPart") then
                    pcall(function() p.TextureID = "" end)
                elseif p:IsA("SpecialMesh") or p:IsA("FileMesh") then
                    pcall(function() p.TextureId = "" end)
                end
            end
            pcall(function()
                if def:IsA("MeshPart") then def.TextureID = "" end
                def.Color = neon
                def.Material = Enum.Material.SmoothPlastic
                def.Transparency = 0
            end)
            table.insert(tinted, def)
            pcall(function()
                for _, d in ipairs(tool:GetDescendants()) do
                    local cn = nil
                    pcall(function() cn = d.ClassName end)
                    if cn == "SurfaceAppearance" or cn == "MeshPart"
                        or cn == "SpecialMesh" or cn == "FileMesh"
                        or d:IsA("BasePart") then
                        solidTint(d)
                    end
                end
                local h = tool:FindFirstChild("Handle")
                if h and h:IsA("BasePart") and st.solidParts[h] == nil then
                    solidTint(h)
                end
            end)
            local conn
            conn = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if def.Parent then
                        if def.Color ~= neon then def.Color = neon end
                        if def:IsA("MeshPart") and def.TextureID ~= "" then
                            def.TextureID = ""
                        end
                    end
                    for _, d in ipairs(tool:GetDescendants()) do
                        if d:IsA("BasePart") then
                            if d.Color ~= neon then d.Color = neon end
                            if d:IsA("MeshPart") and d.TextureID ~= "" then
                                d.TextureID = ""
                            end
                        elseif d:IsA("SurfaceAppearance") then
                            if d.ColorMap ~= "" then d.ColorMap = "" end
                        elseif d:IsA("MeshPart") then
                            if d.TextureID ~= "" then d.TextureID = "" end
                        elseif d:IsA("SpecialMesh") or d:IsA("FileMesh") then
                            pcall(function()
                                if d.TextureId ~= "" then d.TextureId = "" end
                            end)
                        end
                    end
                end)
                if tool.Parent == nil then
                    pcall(function() conn:Disconnect() end)
                end
            end)
            table.insert(st.conns, conn)
        else
            pcall(function()
                if def:IsA("MeshPart") then
                    def.TextureID = custom.Texture
                end
            end)
            pcall(function() def.Transparency = 0 end)
            pcall(function() def.Color = neon end)
            table.insert(tinted, def)
            animateTinted()
        end
    else
        -- Shadow base - get the actual Shadow model and apply custom texture to it
        local baseSkin = base
        local baseInfo = getGunInfo(tool.Name, baseSkin)
        local baseMesh = baseInfo and baseInfo.TextureID
        if typeof(baseMesh) == "Instance" and baseMesh:IsA("MeshPart") then
            local clone = baseMesh:Clone()
            if typeof(clone) ~= "Instance" or not clone:IsA("BasePart") then return end
            pcall(function() clone:SetAttribute("_vanilla", true) end)
            pcall(function() clone.Name = "CurrentSkin" end)
            pcall(function()
                clone.CanCollide = false
                clone.Anchored = false
                clone.Massless = true
            end)
            pcall(function() clone.TextureID = custom.Texture end)
            pcall(function() clone.Color = neon end)
            table.insert(tinted, clone)
            -- pcall: on Xeno a bad `tool` value threw here and broke skins.
            local okPar = pcall(function() clone.Parent = tool end)
            if not okPar then
                pcall(function() clone:Destroy() end)
                CustomGunState[tool] = nil
                return
            end
            pcall(function() clone.CFrame = def.CFrame end)
            local w = Instance.new("Weld")
            pcall(function()
                w.Part0 = clone
                w.Part1 = def
            end)
            local c0 = CFrame.new()
            if baseInfo.CFrame and typeof(baseInfo.CFrame) == "CFrame" then
                local ok, inv = pcall(function() return baseInfo.CFrame:Inverse() end)
                if ok and typeof(inv) == "CFrame" then c0 = inv end
            end
            pcall(function()
                w.C0 = c0
                w.Parent = clone
            end)
            table.insert(st.clones, clone)
            table.insert(st.clones, w)
            tintInside(clone)
            if custom.Solid then
                local isRGBSolid = custom.RGB == true
                local BLACKSOLID = Color3.fromRGB(0, 0, 0)
                pcall(function()
                    if isRGBSolid then
                        clone.Material = Enum.Material.Neon
                    else
                        clone.Material = Enum.Material.SmoothPlastic
                    end
                    if clone:IsA("MeshPart") and clone.TextureID ~= "" then
                        clone.TextureID = ""
                    end
                    for _, d in ipairs(clone:GetDescendants()) do
                        if d:IsA("BasePart") then
                            if isRGBSolid and d.Name:lower() == "neon" then
                                d.Color = BLACKSOLID
                                d.Material = Enum.Material.SmoothPlastic
                            else
                                d.Color = neon
                                if isRGBSolid then
                                    d.Material = Enum.Material.Neon
                                else
                                    d.Material = Enum.Material.SmoothPlastic
                                end
                            end
                            if d:IsA("MeshPart") and d.TextureID ~= "" then
                                d.TextureID = ""
                            end
                        elseif d:IsA("SurfaceAppearance") then
                            if d.ColorMap ~= "" then d.ColorMap = "" end
                        elseif d:IsA("SpecialMesh") or d:IsA("FileMesh") then
                            pcall(function() d.TextureId = "" end)
                        end
                    end
                end)
            end
            def.Transparency = 1
            animateTinted()
        elseif typeof(baseMesh) == "Instance" and (baseMesh:IsA("Model") or baseMesh:IsA("Folder")) then
            local clone = baseMesh:Clone()
            if typeof(clone) ~= "Instance" then return end
            pcall(function() clone:SetAttribute("_vanilla", true) end)
            pcall(function()
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d:SetAttribute("_vanilla", true)
                        d.CanCollide = false
                        d.Anchored = false
                        d.Massless = true
                    end
                end
            end)
            if clone:IsA("Model") and not clone.PrimaryPart then
                for _, c in ipairs(clone:GetChildren()) do
                    if c:IsA("BasePart") then
                        pcall(function() clone.PrimaryPart = c end)
                        break
                    end
                end
            end
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("MeshPart") then
                    pcall(function() d.TextureID = custom.Texture end)
                end
            end
            if clone:IsA("MeshPart") then
                pcall(function() clone.TextureID = custom.Texture end)
            end
            local c0 = CFrame.new()
            local scanned = baseInfo.Scanned == true
            if baseInfo.CFrame and typeof(baseInfo.CFrame) == "CFrame" then
                local ok, inv = pcall(function() return baseInfo.CFrame:Inverse() end)
                if ok and typeof(inv) == "CFrame" then c0 = inv end
            end
            -- Reference frame of the scanned model so its parts keep their
            -- shape on the gun (Hood-style). SkinDB clones keep old behavior.
            local baseRef = nil
            if scanned then
                pcall(function()
                    if clone:IsA("Model") and clone.PrimaryPart then
                        baseRef = clone.PrimaryPart.CFrame
                    else
                        local biggest, bestV = nil, -1
                        for _, b in ipairs(clone:GetDescendants()) do
                            if b:IsA("BasePart") then
                                local v = b.Size.X * b.Size.Y * b.Size.Z
                                if v > bestV then bestV, biggest = v, b end
                            end
                        end
                        if biggest then baseRef = biggest.CFrame end
                    end
                end)
            end
            -- Snapshot every part's offset up front: parts get moved during
            -- welding, so computing offsets lazily would distort the shape.
            local relOffsets = nil
            if scanned and baseRef then
                relOffsets = {}
                pcall(function()
                    for _, b in ipairs(clone:GetDescendants()) do
                        if b:IsA("BasePart") then
                            relOffsets[b] = baseRef:ToObjectSpace(b.CFrame)
                        end
                    end
                end)
            end
            if clone:IsA("Model") and clone.PrimaryPart then
                for _, p in ipairs(clone:GetDescendants()) do
                    if p:IsA("BasePart") then
                        local w = Instance.new("Weld")
                        pcall(function()
                            if scanned and baseRef and p == clone.PrimaryPart then
                                -- Hood-style: part placed explicitly on the gun.
                                local off = (relOffsets and relOffsets[p]) or baseRef:ToObjectSpace(p.CFrame)
                                p.CFrame = def.CFrame * off
                                w.Part0 = def
                                w.Part1 = p
                                w.C0 = off
                            elseif p == clone.PrimaryPart then
                                w.Part0 = p
                                w.Part1 = def
                                w.C0 = c0
                            else
                                w.Part0 = p
                                w.Part1 = clone.PrimaryPart
                                w.C0 = p.CFrame:ToObjectSpace(clone.PrimaryPart.CFrame)
                                w.C1 = CFrame.new()
                            end
                            w.Parent = p
                        end)
                        table.insert(st.clones, w)
                    end
                end
            else
                for _, p in ipairs(clone:GetDescendants()) do
                    if p:IsA("BasePart") then
                        local w = Instance.new("Weld")
                        pcall(function()
                            if scanned and baseRef then
                                local off = (relOffsets and relOffsets[p]) or baseRef:ToObjectSpace(p.CFrame)
                                p.CFrame = def.CFrame * off
                                w.Part0 = def
                                w.Part1 = p
                                w.C0 = off
                            else
                                w.Part0 = p
                                w.Part1 = def
                                w.C0 = c0
                            end
                            w.Parent = p
                        end)
                        table.insert(st.clones, w)
                    end
                end
            end
            local okPar2 = pcall(function() clone.Parent = tool end)
            if not okPar2 then
                pcall(function() clone:Destroy() end)
                CustomGunState[tool] = nil
                return
            end
            table.insert(st.clones, clone)
            tintInside(clone)
            -- Verify the clone actually has visible geometry: an empty pick
            -- used to leave an invisible gun with zero errors.
            local visCount = 0
            pcall(function()
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("BasePart") and d.Transparency < 1 then
                        visCount = visCount + 1
                        break
                    end
                end
            end)
            if visCount == 0 then
                warn("Celestite skins: scanned '" .. tostring(base) .. "' clone for " .. tool.Name .. " has no visible parts, fell back to retexture")
                cleanCustomGun(tool)
                return
            end
            if custom.Solid then
                local isRGBSolid2 = custom.RGB == true
                local BLACKSOLID2 = Color3.fromRGB(0, 0, 0)
                pcall(function()
                    for _, d in ipairs(clone:GetDescendants()) do
                        if d:IsA("BasePart") then
                            if isRGBSolid2 and d.Name:lower() == "neon" then
                                d.Color = BLACKSOLID2
                                d.Material = Enum.Material.SmoothPlastic
                            else
                                d.Color = neon
                                if isRGBSolid2 then
                                    d.Material = Enum.Material.Neon
                                else
                                    d.Material = Enum.Material.SmoothPlastic
                                end
                            end
                            if d:IsA("MeshPart") and d.TextureID ~= "" then
                                d.TextureID = ""
                            end
                        elseif d:IsA("SurfaceAppearance") then
                            if d.ColorMap ~= "" then d.ColorMap = "" end
                        elseif d:IsA("SpecialMesh") or d:IsA("FileMesh") then
                            pcall(function() d.TextureId = "" end)
                        end
                    end
                    if clone:IsA("BasePart") then
                        clone.Color = neon
                        if isRGBSolid2 then
                            clone.Material = Enum.Material.Neon
                        else
                            clone.Material = Enum.Material.SmoothPlastic
                        end
                    end
                end)
            end
            def.Transparency = 1
            animateTinted()
        else
            -- No base model found: texture the tool's own mesh directly.
            -- pcall everything: `def` may be a plain Part with no TextureID,
            -- which threw on Xeno and killed skins.
            pcall(function()
                if def:IsA("MeshPart") then
                    def.TextureID = custom.Texture
                end
            end)
            pcall(function()
                for _, d in ipairs(tool:GetDescendants()) do
                    if d:IsA("MeshPart") then
                        d.TextureID = custom.Texture
                    elseif d:IsA("SpecialMesh") or d:IsA("FileMesh") then
                        d.TextureId = custom.Texture
                    elseif d:IsA("SurfaceAppearance") then
                        d.ColorMap = custom.Texture
                    end
                end
            end)
            pcall(function() def.Transparency = 0 end)
            pcall(function() def.Color = neon end)
            table.insert(tinted, def)
            animateTinted()
        end
    end

    -- Electric 3.0 / 4.0 glow fix: the Electric base model carries blue neon
    -- parts plus glow effects (emitters/lights/beams) that the generic tint
    -- leaves untouched, so the gun keeps a blue glow. Force everything to
    -- the skin color (3.0 = white, 4.0 = light blue) and keep enforcing it.
    if skinName == "Electric 3.0" or skinName == "Electric 4.0" then
        local ecol = CUSTOM_BULLETS[skinName] or Color3.fromRGB(255, 255, 255)
        local function paintGlow(root)
            pcall(function()
                if root:IsA("BasePart") then
                    root.Color = ecol
                elseif root:IsA("ParticleEmitter") or root:IsA("Beam") or root:IsA("Trail") then
                    root.Color = ColorSequence.new(ecol)
                elseif root:IsA("PointLight") or root:IsA("SpotLight") or root:IsA("SurfaceLight") then
                    root.Color = ecol
                end
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Color = ecol
                    elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
                        pcall(function() d.Color = ColorSequence.new(ecol) end)
                    elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                        pcall(function() d.Color = ecol end)
                    end
                end
            end)
        end
        for _, v in ipairs(st.clones) do
            if typeof(v) == "Instance" and (v:IsA("BasePart") or v:IsA("Model") or v:IsA("Folder")) then
                paintGlow(v)
            end
        end
        local ecolConn
        ecolConn = RunService.Heartbeat:Connect(function()
            pcall(function()
                for _, v in ipairs(st.clones) do
                    if typeof(v) == "Instance" and v.Parent then
                        if v:IsA("BasePart") and v.Color ~= ecol then v.Color = ecol end
                        for _, d in ipairs(v:GetDescendants()) do
                            if d:IsA("BasePart") then
                                if d.Color ~= ecol then d.Color = ecol end
                            elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
                                pcall(function()
                                    if d.Color ~= ColorSequence.new(ecol) then d.Color = ColorSequence.new(ecol) end
                                end)
                            elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                                pcall(function()
                                    if d.Color ~= ecol then d.Color = ecol end
                                end)
                            end
                        end
                    end
                end
            end)
            if tool.Parent == nil then pcall(function() ecolConn:Disconnect() end) end
        end)
        table.insert(st.conns, ecolConn)
    end

    if handle then
        for _, e in ipairs(handle:GetChildren()) do
            if e:IsA("ParticleEmitter") and e:GetAttribute("_vanilla") then
                pcall(function() e:Destroy() end)
            end
        end
        pcall(function() handle:SetAttribute("SkinName", skinName) end)
        local okSig, sig = pcall(function() return handle:GetAttributeChangedSignal("SkinName") end)
        if okSig and sig then
            local okConn, cc = pcall(function()
                return sig:Connect(function()
                    if handle:GetAttribute("SkinName") ~= skinName then
                        pcall(function() handle:SetAttribute("SkinName", skinName) end)
                    end
                end)
            end)
            if okConn and cc then table.insert(st.conns, cc) end
        end
    end

    pcall(function() tool:SetAttribute("CustomSkin", skinName) end)
end

-- Bullet color function (for neon coloring on guns only - no shoot FX)
local function bulletColorFor(skin)
    if skin == "Cosmic" then
        local t = (math.sin(tick() * 2.2) + 1) / 2
        return Color3.fromHSV(0.58 + 0.22 * t, 1, 1)
    end
    if skin == "RGB" then
        return Color3.fromHSV((tick() * 0.15) % 1, 1, 1)
    end
    if CUSTOM_BULLETS[skin] then
        return CUSTOM_BULLETS[skin]
    end
    return Color3.fromRGB(255, 255, 255)
end

local function gunBulletColor(tool, skin)
    if skin == "RGB" then
        return bulletColorFor(skin)
    end
    if skin == "Electric 3.0" or skin == "Electric 4.0" then
        -- forced tracer (white / light blue): mesh colors can't be trusted
        -- on low executors, and Model-branch clones keep base colors.
        return bulletColorFor(skin)
    end
    local custom = getCustomDef(tool.Name, skin)
    if custom then
        for _, v in ipairs(tool:GetChildren()) do
            if v:GetAttribute("_vanilla") then
                if v:IsA("BasePart") then
                    local neon = nil
                    pcall(function()
                        for _, d in ipairs(v:GetDescendants()) do
                            if d:IsA("BasePart") and d.Name:lower() == "neon" then neon = d break end
                        end
                    end)
                    if neon then
                        local ok2, c2 = pcall(function() return neon.Color end)
                        if ok2 and c2 then return c2 end
                    end
                    local ok, c = pcall(function() return v.Color end)
                    if ok and c then return c end
                elseif v:IsA("Model") or v:IsA("Folder") then
                    local neon = nil
                    pcall(function()
                        for _, d in ipairs(v:GetDescendants()) do
                            if d:IsA("BasePart") and d.Name:lower() == "neon" then neon = d break end
                        end
                    end)
                    if neon then
                        local ok2, c2 = pcall(function() return neon.Color end)
                        if ok2 and c2 then return c2 end
                    end
                    for _, d in ipairs(v:GetDescendants()) do
                        if d:IsA("BasePart") then
                            local ok3, c3 = pcall(function() return d.Color end)
                            if ok3 and c3 then return c3 end
                            break
                        end
                    end
                end
            end
        end
        local def = defaultMesh(tool)
        if def then
            local ok, c = pcall(function() return def.Color end)
            if ok and c then return c end
        end
    end
    return bulletColorFor(skin)
end

local function paintBeam(obj, tool, skin)
    local col = gunBulletColor(tool, skin)
    pcall(function() obj.Color = ColorSequence.new(col) end)
    task.delay(0.05, function()
        pcall(function()
            if obj.Parent then
                obj.Color = ColorSequence.new(gunBulletColor(tool, skin))
            end
        end)
    end)
end

-- Global last shot tracking for bullet colors
local lastShot = { t = 0, tool = nil, skin = "" }

-- Knife FX tracking
local lastKnife = { t = 0, tool = nil, skin = "" }

local function tantoFxColor(skin)
    local kc = CUSTOM_KNIVES[skin]
    if kc then return kc.Fx or kc.Color end
    return nil
end

local function equippedSkinnedGun()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then
            local skin = t:GetAttribute("CustomSkin")
            if skin and skin ~= "" and skin ~= "Default" and skin ~= "None" then
                return t, skin
            end
        end
    end
    return nil, nil
end

Workspace.DescendantAdded:Connect(function(obj)
    local isBeam = obj:IsA("Beam")
    local isTrail = not isBeam and obj:IsA("Trail")
    local isKnifeFx = obj:IsA("ParticleEmitter") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
    if (isBeam or isTrail or isKnifeFx) and lastKnife.skin ~= "" and tantoFxColor(lastKnife.skin) then
        if os.clock() - lastKnife.t < 0.6 then
            local kc = tantoFxColor(lastKnife.skin)
