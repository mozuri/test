                                data.toolLabel.Position = UDim2.fromOffset(centerX - 100, bottomY + 2)
                                data.toolLabel.Size = UDim2.fromOffset(200, 16)
                                
                                -- Check for equipped tool by looking in character and its descendants
                                local equippedTool = nil
                                for _, child in ipairs(char:GetDescendants()) do
