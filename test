}
local animRespawnConn = nil
local function animStopAll(humanoid)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        pcall(function()
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                track:Stop(0.1)
            end
        end)
    end
end
local function animApplyTo(character)
    task.spawn(function()
        task.wait(0.5)
        if getgenv().CelestiteUnloaded then return end
        local ok, animate = pcall(function() return character:WaitForChild("Animate", 10) end)
        if not ok or not animate then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        animStopAll(humanoid)
        pcall(function()
            animate.run.RunAnim.AnimationId = AnimSet.Run
            animate.jump.JumpAnim.AnimationId = AnimSet.Jump
            animate.fall.FallAnim.AnimationId = AnimSet.Fall
            animate.idle.Animation1.AnimationId = AnimSet.Idle1
            animate.idle.Animation2.AnimationId = AnimSet.Idle2
        end)
        pcall(function()
            local w1 = animate.idle.Animation1:FindFirstChild("Weight")
            if not w1 then
                w1 = Instance.new("NumberValue")
                w1.Name = "Weight"
                w1.Value = 9
                w1.Parent = animate.idle.Animation1
            else
                w1.Value = 9
            end
            local w2 = animate.idle.Animation2:FindFirstChild("Weight")
            if not w2 then
                w2 = Instance.new("NumberValue")
                w2.Name = "Weight"
                w2.Value = 1
                w2.Parent = animate.idle.Animation2
            else
                w2.Value = 1
            end
        end)
        humanoid.Jump = false
    end)
end
getgenv().SetAnimEnabled = function(on)
    if animRespawnConn then pcall(function() animRespawnConn:Disconnect() end) animRespawnConn = nil end
    if on then
        if LocalPlayer.Character then animApplyTo(LocalPlayer.Character) end
        animRespawnConn = LocalPlayer.CharacterAdded:Connect(animApplyTo)
    end
end

-- UNLOAD (Configs tab "unload script" button). Stops all work first so
-- nothing re-applies mid-cleanup, then restores everything touched.
getgenv().VanillaUnload = function()
    getgenv().CelestiteUnloaded = true
    pcall(function()
        if getgenv().AimbotConfig then getgenv().AimbotConfig.Enabled = false end
        if getgenv().SilentConfig then getgenv().SilentConfig.Enabled = false end
        if getgenv().ESPConfig then getgenv().ESPConfig.Enabled = false end
        if getgenv().WalkspeedConfig then getgenv().WalkspeedConfig.Enabled = false end
        if getgenv().HeadlessConfig then getgenv().HeadlessConfig.Enabled = false end
        if getgenv().WorldConfig then
            getgenv().WorldConfig.SkyboxEnable = false
            getgenv().WorldConfig.TextureEnable = false
            getgenv().WorldConfig.TimeEnable = false
            getgenv().WorldConfig.SkyboxSpin = false
        end
        if getgenv().AtmosphereConfig then
            getgenv().AtmosphereConfig.Enable = false
            getgenv().AtmosphereConfig.WeatherEnable = false
        end
        if getgenv().CustomSkins then getgenv().CustomSkins.Enable = false end
        if getgenv().HoodCustoms then
            for _, Cfg in pairs(getgenv().HoodCustoms['Skins']) do Cfg['Enabled'] = false end
            if getgenv().HoodCustoms['BeamChanger'] then getgenv().HoodCustoms['BeamChanger'].Enabled = false end
        end
    end)
    pcall(function() aimbotEnemy = nil end)
    pcall(function() isSpeedEnabled = false end)
    pcall(function() BeamApplied = nil end)
    pcall(function()
        if charRespawnConn then charRespawnConn:Disconnect() end
        charRespawnConn = nil
        if animRespawnConn then animRespawnConn:Disconnect() end
        animRespawnConn = nil
    end)
    -- movement back to normal
    pcall(function()
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end)
    pcall(function() if speedConnection then speedConnection:Disconnect() end end)
    pcall(function()
        if getgenv().Spectate then getgenv().Spectate.uid = nil end
        local cam = Workspace.CurrentCamera
        local me = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if cam and me then cam.CameraSubject = me end
        if cam then cam.CameraType = Enum.CameraType.Custom end
    end)
    -- head back
    pcall(function()
        local c = LocalPlayer.Character
        local head = c and c:FindFirstChild("Head")
        if head then
            if originalHeadTransparency ~= nil then head.Transparency = originalHeadTransparency end
            local face = head:FindFirstChild("face")
            if face and originalFaceTransparency ~= nil then face.Transparency = originalFaceTransparency end
        end
    end)
    -- map materials back
    pcall(function()
        for part, origMat in pairs(originalMaterials) do
            if part and part.Parent then pcall(function() part.Material = origMat end) end
        end
        originalMaterials = {}
    end)
    -- sky / time / atmosphere / weather back
    pcall(function()
        local ours = ourSky()
        if ours then ours:Destroy() end
        if savedSky then
            local sky = Instance.new("Sky")
            sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = savedSky.Bk, savedSky.Dn, savedSky.Ft
            sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = savedSky.Lf, savedSky.Rt, savedSky.Up
            sky.Parent = Lighting
            savedSky = nil
        end
        lastSky = nil
    end)
    pcall(function()
        if originalTime ~= nil then Lighting.ClockTime = originalTime end
        originalTime = nil
    end)
    pcall(function()
        local atm = Lighting:FindFirstChild("CelestiteAtmo")
        if atm then atm:Destroy() end
        originalAtmosphere = nil
    end)
    pcall(function() weatherTeardown() end)
    -- guns back to stock
    pcall(function()
        for tool, _ in pairs(CustomGunState) do cleanCustomGun(tool) end
        CustomGunState = {}
        local ch = LocalPlayer.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") then pcall(cleanCustomGun, t) end
            end
        end
    end)
    pcall(function()
        local ch = LocalPlayer.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") then HoodRestoreSkin(t) end
            end
        end
    end)
    -- ESP drawings off + gone
    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then espRemoveCham(plr.Character) end
        end
        for _, data in pairs(ESPCache) do espHideAll(data) end
        if aimbotCircle then aimbotCircle.Visible = false end
        if silentCircle then silentCircle.Visible = false end
    end)
    pcall(function() if aimbotCircle then aimbotCircle:Remove() end end)
    pcall(function() if silentCircle then silentCircle:Remove() end end)
    -- GUI gone
    pcall(function()
        local lib = getgenv().library
        if lib then
            for _, cn in ipairs(lib.connections or {}) do pcall(function() cn:Disconnect() end) end
            if lib.items then lib.items:Destroy() end
            if lib.other then lib.other:Destroy() end
        end
        if espGui then espGui:Destroy() end
    end)
end


