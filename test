-- WEATHER (SNOWFLAKES/RAIN)
local COUNT, RADIUS, HEIGHT = 300, 120, 80
local weatherFolder, weatherFlakes, lastWeatherMode = nil, {}, nil

local function weatherModeCfg()
    if string.lower(tostring(getgenv().AtmosphereConfig.Weather or "snowflakes")) == "rain" then
        return { Color = Color3.fromRGB(150, 200, 255), Transparency = 0.3, Size = 0.3, Fall = 60, Drift = 2 }
    end
    return { Color = Color3.fromRGB(255, 255, 255), Transparency = 0.1, Size = 0.5, Fall = 14, Drift = 4 }
end

local function weatherEnsure()
    if weatherFolder and weatherFolder.Parent then return end
    if weatherFolder then weatherFolder:Destroy() end
    weatherFlakes = {}
    weatherFolder = Instance.new("Folder")
    weatherFolder.Name = "CelestiteWeather"
    weatherFolder.Parent = Workspace
    for i = 1, COUNT do
        local p = Instance.new("Part")
        p.Name = "flake"
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Shape = Enum.PartType.Ball
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        p.Parent = weatherFolder
        local c = weatherModeCfg()
        p.Color, p.Transparency, p.Size = c.Color, c.Transparency, Vector3.new(c.Size, c.Size, c.Size)
        local cam = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position or Vector3.new()
        local ang = math.random() * math.pi * 2
        local r = math.random() * RADIUS
        p.Position = cam + Vector3.new(math.cos(ang) * r, HEIGHT * (0.5 + math.random() * 0.5), math.sin(ang) * r)
        table.insert(weatherFlakes, { part = p, speed = c.Fall * (0.7 + math.random() * 0.6), phase = math.random() * math.pi * 2 })
    end
    lastWeatherMode = string.lower(tostring(getgenv().AtmosphereConfig.Weather or "snowflakes"))
end

local function weatherTeardown()
    if weatherFolder then pcall(function() weatherFolder:Destroy() end) end
    weatherFolder = nil
    weatherFlakes = {}
    lastWeatherMode = nil
end

local weatherElapsed = 0
RunService.Heartbeat:Connect(function(dt)
    if not getgenv().AtmosphereConfig then
        if weatherFolder then weatherTeardown() end
        return
    end
    if getgenv().AtmosphereConfig.WeatherEnable ~= true then
        if weatherFolder then weatherTeardown() end
        return
    end
    weatherEnsure()
    local mode = string.lower(tostring(getgenv().AtmosphereConfig.Weather or "snowflakes"))
    if mode ~= lastWeatherMode then
        local c = weatherModeCfg()
        for _, d in ipairs(weatherFlakes) do
            if d.part and d.part.Parent then
                d.part.Color, d.part.Transparency = c.Color, c.Transparency
                d.speed = c.Fall * (0.7 + math.random() * 0.6)
            end
        end
        lastWeatherMode = mode
    end
    weatherElapsed = weatherElapsed + dt
    local cam = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position or Vector3.new()
    local c = weatherModeCfg()
    for _, d in ipairs(weatherFlakes) do
        local p = d.part
        if p and p.Parent then
            local pos = p.Position + Vector3.new(math.sin(weatherElapsed + d.phase) * c.Drift * dt, -d.speed * dt, math.cos(weatherElapsed * 0.7 + d.phase) * c.Drift * dt)
            p.Position = pos
            if pos.Y < cam.Y - 15 or (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(cam.X, 0, cam.Z)).Magnitude > RADIUS * 1.5 then
                local ang = math.random() * math.pi * 2
                local r = math.random() * RADIUS
                p.Position = cam + Vector3.new(math.cos(ang) * r, HEIGHT, math.sin(ang) * r)
            end
        end
    end
end)

