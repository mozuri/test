        function Tab:Configs(side)
            local ConfigSection = Tab:Section("Configuration", side or "Left")
            local ConfigPath = "celestite/"
            -- Xeno has no folder funcs: skip on-disk configs instead of erroring
            -- (which previously broke the whole Settings tab on low executors).
            local ConfigsSupported = HAS_FOLDERS and HAS_FILES
            if ConfigsSupported then
                pcall(function()
                    if not isfolder(ConfigPath) then makefolder(ConfigPath) end
                end)
            end

            local ConfigName = ""
            local NameBox = ConfigSection:TextBox({ Name = "Config Name", Placeholder = "...", Callback = function(v) ConfigName = v end })
            local ConfigList = ConfigSection:Dropdown({ Name = "Saved Configs", Options = {} })

            local function Refresh(quiet)
                local names = {}
                local seen = {}
                if ConfigsSupported then
                    pcall(function()
                        local function collect(path)
                            local okL, files = pcall(listfiles, path)
                            if not okL or type(files) ~= "table" then return end
                            for _, file in pairs(files) do
                                local base = tostring(file):match("([^/\\]+)$") or tostring(file)
                                -- only .json files (case-insensitive), strip ext
                                if base:lower():sub(-5) == ".json" then
                                    local clean = base:sub(1, -6)
                                    if clean ~= "" and not seen[clean] then
                                        seen[clean] = true
                                        names[#names + 1] = clean
                                    end
                                end
                            end
                        end
                        -- some executors only list one spelling; merge both
                        collect(ConfigPath)
                        collect("celestite")
                    end)
                end
                table.sort(names)
                -- dot-call: ConfigList:Refresh(names) would pass self as the list
                ConfigList.Refresh(names)
                -- keep the selection valid; auto-pick first so Load works
                local cur = nil
                pcall(function() cur = ConfigList:Get() end)
                local stillThere = false
                for _, n in ipairs(names) do
                    if n == cur then stillThere = true break end
                end
                if not stillThere then
                    pcall(function() ConfigList.Set(#names > 0 and names[1] or "") end)
                end
                if not quiet then
                    if #names > 0 then
                        Library:Notification({ Text = "Found " .. #names .. " configs: " .. table.concat(names, ", "), Duration = 3 })
                    else
                        Library:Notification({ Text = "No configs found in folder", Duration = 2 })
                    end
                end
            end

            ConfigList.OnOpen = function() Refresh(true) end

            ConfigSection:Button({ Name = "Refresh List", Callback = function()
                Refresh()
            end })

            ConfigSection:Button({ Name = "Save Config", Callback = function()
                if not ConfigsSupported then
                    Library:Notification({ Text = "Configs not supported on this executor", Duration = 3 })
                    return
                end
                -- read the box live: FocusLost may never have fired
                local name = ""
                pcall(function() name = NameBox:GetText() or "" end)
                if name == "" then name = ConfigName end
                name = tostring(name):gsub("^%s+", ""):gsub("%s+$", "")
                if name == "" then
                    Library:Notification({ Text = "Enter a config name", Duration = 3 })
                    return
                end
                local data = { Theme = {}, Flags = {} }
                for k, v in pairs(Library.Theme) do data.Theme[k] = {v.R * 255, v.G * 255, v.B * 255} end
                for k, v in pairs(Library.Flags) do
                    local okF, val = pcall(function()
                        if type(v) ~= "table" then return nil end
                        if v.Get then return v.Get() end
                        if v.GetState then return v.GetState() end
                        if v.GetText then return v.GetText() end
                        return nil
                    end)
                    if okF and val ~= nil then
                        if typeof(val) == "Color3" then val = {val.R * 255, val.G * 255, val.B * 255} end
                        -- JSON-safe only (skip userdata like KeyCode binds)
                        local tv = typeof(val)
                        if tv == "string" or tv == "number" or tv == "boolean" or tv == "table" then
                            data.Flags[k] = val
                        end
                    end
                end
                local success, err = pcall(function()
                    if not isfolder(ConfigPath) then makefolder(ConfigPath) end
                    writefile(ConfigPath .. name .. ".json", game:GetService("HttpService"):JSONEncode(data))
                end)
                if success then
                    Refresh(true)
                    pcall(function() ConfigList.Set(name) end)
                    Library:Notification({ Text = "Saved config: " .. name, Duration = 3 })
                else
                    Library:Notification({ Text = "Error saving config", Duration = 5 })
                end
            end })
            
            ConfigSection:Button({ Name = "Load Config", Callback = function()
                local selected = ConfigList:Get()
                if not selected or selected == "" then return end
                local path = ConfigPath .. selected .. ".json"
                local success, err = pcall(function()
                    local data = game:GetService("HttpService"):JSONDecode(readfile(path))
                    for k, v in pairs(data.Theme or {}) do if Library.Theme[k] then Library.Theme[k] = Color3.fromRGB(v[1], v[2], v[3]) end end
                    Library:UpdateTheme()
                    for k, v in pairs(data.Flags or {}) do
                        local f = Library.Flags[k]
                        -- dot-call + per-flag pcall: one bad entry (e.g. a
                        -- keybind flag with no Set) must not kill the load
                        if f and f.Set then
                            local val = v
                            if type(val) == "table" and #val == 3 then val = Color3.fromRGB(val[1], val[2], val[3]) end
                            pcall(function() f.Set(val) end)
                        end
                    end
                end)
                if success then
                    Library:Notification({ Text = "Loaded config: " .. selected, Duration = 3 })
                else
                    Library:Notification({ Text = "Error loading config", Duration = 5 })
                end
            end })

            ConfigSection:Button({ Name = "Delete Config", Callback = function()
                local selected = ConfigList:Get()
                if not selected or selected == "" then return end
                pcall(function() delfile(ConfigPath .. selected .. ".json") end)
                Refresh()
            end })

            task.spawn(function()
                Refresh(true)
                task.wait(0.5)
                Refresh(true)
            end)
            
            return ConfigSection
        end

        return Tab
    end
    
    task.delay(0.2, function() Library:UpdateTheme() end)
    return Window
end

