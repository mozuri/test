    if not HC or not HC['Skins'] then return end
    local Char = LocalPlayer.Character
    if Char then
        for GunName, Cfg in pairs(HC['Skins']) do
            -- Look for the tool by matching the weapon name from the tool name
            for _, Tool in ipairs(Char:GetChildren()) do
                if Tool:IsA("Tool") then
                    local weaponNameFromTool = Tool.Name:match("^%[(.+)%]$")
                    if not weaponNameFromTool then continue end
                    -- Match using the working reference approach
                    -- GunName is like "DoubleBarrel", weaponNameFromTool is like "Double-Barrel SG"
                    -- We need to map them for matching
                    local match = false
                    if weaponNameFromTool == GunName then
                        match = true
                    elseif GunName == "DoubleBarrel" and weaponNameFromTool == "Double-Barrel SG" then
                        match = true
                    elseif pcall(function() return weaponNameFromTool:find(GunName) end) and weaponNameFromTool:find(GunName) then
                        match = true
                    elseif pcall(function() return GunName:find(weaponNameFromTool) end) and GunName:find(weaponNameFromTool) then
                        match = true
                    end
                    
                    if match then
                        if Cfg['Enabled'] and Cfg['Skin'] and Cfg['Skin'] ~= "None" then
                            HoodApplySkin(Tool, weaponNameFromTool, Cfg['Skin'])
                        else
                            HoodRestoreSkin(Tool)
                        end
                    end
                end
            end
        end
    end
    HoodApplyBeamChanger()
end)

