end)

-- ---- Hook #1: Mouse Hit/Target/X/Y spoof (priv da hood GetAim uses Mouse.Hit.p) ----
task.spawn(function()
    if not HAS_HOOKS then
        warn("Silent aim: hook funcs missing, mouse ghost-aim disabled")
        return
    end
    local okm, mouse = pcall(function() return LocalPlayer:GetMouse() end)
    if not okm or not mouse then
        warn("Silent aim: could not retrieve mouse")
        return
    end
    silentMouse = mouse

    local mt = getrawmetatable(mouse)
    if not mt then
        warn("Silent aim: mouse metatable not accessible")
        return
    end

    local oldIndex = mt.__index
    if setreadonly then pcall(function() setreadonly(mt, false) end) end

    local function hook(self, key)
        local cc = (checkcaller and checkcaller()) or false
        if not cc and silentOn() and self == silentMouse then
            if key == "Hit" then
                local part, aimPos = getSilentAimCached()
                if part and aimPos then
                    return CFrame.new(aimPos)
                end
            elseif key == "Target" then
                local part, aimPos = getSilentAimCached()
                if part and aimPos then
                    return part
                end
            elseif key == "X" or key == "Y" then
                if not getgenv().VanillaHCHookFn then
                    local v = getSilentXY(key)
                    if v then return v end
                end
            end
        end
        if type(oldIndex) == "function" then
            return oldIndex(self, key)
        else
            return oldIndex[key]
        end
    end

    mt.__index = (newcclosure and newcclosure(hook)) or hook
    if setreadonly then pcall(function() setreadonly(mt, true) end) end
    warn("Silent aim: mouse Hit/Target/X/Y hook installed")
end)

-- ---- Hook #2: priv da hood GunHandler.GetAim + GunHandler.Shoot override ----
-- Your game: AimPosition = Origin + GetAim(Origin)*Range, then
-- MainRemoteEvent:FireServer("ShootGun", Handle, Origin, PelletData/R1R2R3)
-- Table assignment works without hookfunction (gun calls GunHandler.GetAim each shot).
task.spawn(function()
    task.wait(2)
    local ok, GunHandler = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GunHandler"))
    end)
    if not ok or not GunHandler then
        warn("Silent aim: GunHandler not found, namecall hook only")
        return
    end
    getgenv().PrivGunHandler = GunHandler

    if GunHandler.GetAim then
        local OldGetAim = GunHandler.GetAim
        GunHandler.GetAim = function(Origin)
            if silentOn() then
                local part, aimPos = getSilentAimCached()
                if part and aimPos and typeof(Origin) == "Vector3" then
                    local d = (aimPos - Origin)
                    if d.Magnitude > 0.001 then
                        return d.Unit, d.Magnitude
                    end
                end
            end
            return OldGetAim(Origin)
        end
        warn("Silent aim: GunHandler.GetAim overridden")
    end

    if GunHandler.Shoot then
        local OldShoot = GunHandler.Shoot
        GunHandler.Shoot = function(P)
            -- FIX (was visual-only, 0 damage): the old code raycast with the
            -- ORIGINAL miss AimPosition (visual beam to the miss) and only
            -- spoofed the RETURNED Result. Server sees Aim~=Result and
            -- rejects it: beam on your screen only, no damage, invisible to
            -- others. Correct approach: snap P.AimPosition onto the head
            -- Fan dial: spread size 0 = exact-center laser (always damages);
            -- above 0 each pellet gets its own fan point (see net hook: the
            -- SAME point goes into Aim and Result, which is what validates).
            if silentOn() and type(P) == "table" then
                local part, aimPos = getSilentAimCached()
                if part and part.Parent and aimPos then
                    pcall(function()
                        local org = P.ForcedOrigin
                        if typeof(org) == "Vector3" then
