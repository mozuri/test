-- 360 SPIN FLICK (one full 360 yaw per trigger; camera + character turn
-- together so it reads in first person too. Re-triggers while a spin is
-- running are ignored, so it works the same on Toggle and Hold binds.)
getgenv().SpinConfig = getgenv().SpinConfig or { Speed = 5 }
local spinFlick = { active = false, done = 0 }
local function triggerSpinFlick()
    if spinFlick.active then return end
    spinFlick.active = true
    spinFlick.done = 0
end
getgenv().TriggerSpinFlick = triggerSpinFlick
RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        if getgenv().CelestiteUnloaded then return end
        if not spinFlick.active then return end
        local ch = LocalPlayer and LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local cam = Workspace.CurrentCamera or Camera
        local spd = tonumber(getgenv().SpinConfig.Speed) or 5
        local duration = clamp(0.65 - (spd / 10) * 0.5, 0.1, 0.65)
        local step = (math.pi * 2) * (math.min(dt, 0.1) / duration)
        if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, step, 0) end
        if cam then cam.CFrame = cam.CFrame * CFrame.Angles(0, step, 0) end
        spinFlick.done = spinFlick.done + step
        if spinFlick.done >= math.pi * 2 then spinFlick.active = false end
    end)
end)

-- CHAR SCRIPT (wear another user's appearance / revert to your own)
local charRespawnConn = nil
local function charGetUserId(name)
    if not name or name == "" then return nil end
    local ok, id = pcall(function()
        return Players:GetUserIdFromNameAsync(name)
    end)
    if ok and id then return id end
    local plr = Players:FindFirstChild(name)
    if plr then return plr.UserId end
    return nil
end
local function charFindAttachment(character, name)
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Attachment") and d.Name == name then return d end
    end
    return nil
end
local function charWeldAccessory(character, accessory)
    local handle = accessory:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return false end
    local ha = handle:FindFirstChildOfClass("Attachment")
    if not ha then return false end
    local ta = charFindAttachment(character, ha.Name)
    if not ta or not ta.Parent then return false end
    local weld = Instance.new("Weld")
    weld.Name = "AccessoryWeld"
    weld.Part0 = ta.Parent
    weld.Part1 = handle
    weld.C0 = ta.CFrame
    weld.C1 = ha.CFrame
    weld.Parent = handle
    return true
end
local function charClearAppearance(character)
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then
            v:Destroy()
        end
    end
    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("Weld") and v.Name == "AccessoryWeld" then v:Destroy() end
    end
    local head = character:FindFirstChild("Head")
    if head then
        local face = head:FindFirstChild("face")
        if face then face:Destroy() end
    end
end
local function charApplyAppearance(userId, targetChar)
    local character = targetChar or LocalPlayer.Character
    if not character then
        character = LocalPlayer.CharacterAdded:Wait()
    end
    -- wait for spawn to settle so welding never yanks the HRP mid-load
    local hum = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    if not hum then return end
    character:WaitForChild("HumanoidRootPart", 10)
    character:WaitForChild("Head", 10)
    -- snapshot spawn position so re-char can never teleport us
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local savedCF, savedVel, savedAVel = nil, nil, nil
    if hrp then
        pcall(function()
            savedCF = hrp.CFrame
            savedVel = hrp.AssemblyLinearVelocity
            savedAVel = hrp.AssemblyAngularVelocity
        end)
    end
    local ok, appearance = pcall(function()
        return Players:GetCharacterAppearanceAsync(userId)
    end)
    if not ok or not appearance then return end
    -- character may have respawned while we were fetching: abort stale apply
    if character ~= LocalPlayer.Character then
        pcall(function() appearance:Destroy() end)
        return
    end
    charClearAppearance(character)
    for _, v in ipairs(appearance:GetChildren()) do
        if v:IsA("BodyColors") then v:Clone().Parent = character end
    end
    for _, v in ipairs(appearance:GetChildren()) do
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then v:Clone().Parent = character end
    end
    for _, v in ipairs(appearance:GetChildren()) do
        if v:IsA("Accessory") then
            local clone = v:Clone()
            local handle = clone:FindFirstChild("Handle")
            if handle then
                pcall(function()
                    handle.Anchored = true
                    handle.CanCollide = false
                    handle.Massless = true
                end)
            end
            -- position the handle exactly on its attachment BEFORE welding,
            -- otherwise the weld snaps the whole character to the handle's
            -- preview-model coordinates (the respawn teleport bug)
            local placed = false
            if handle then
                local ha = handle:FindFirstChildOfClass("Attachment")
                local ta = ha and charFindAttachment(character, ha.Name)
                if ha and ta and ta.Parent then
                    pcall(function()
                        handle.CFrame = ta.Parent.CFrame * ta.CFrame * ha.CFrame:Inverse()
                    end)
                    placed = true
                end
            end
            clone.Parent = character
            local welded = charWeldAccessory(character, clone)
            if handle then
                -- pin it on the body for a frame, then release
                if placed then
                    pcall(function()
                        local ha2 = handle:FindFirstChildOfClass("Attachment")
                        local ta2 = ha2 and charFindAttachment(character, ha2.Name)
                        if ha2 and ta2 and ta2.Parent then
                            handle.CFrame = ta2.Parent.CFrame * ta2.CFrame * ha2.CFrame:Inverse()
                        end
                    end)
                end
                pcall(function() handle.Anchored = false end)
            end
            if not welded then
                local h2 = character:FindFirstChildOfClass("Humanoid")
                if h2 then pcall(function() h2:AddAccessory(clone) end) end
            end
        end
    end
    local head = character:FindFirstChild("Head")
    if head and appearance:FindFirstChild("face") then
        local old = head:FindFirstChild("face")
        if old then old:Destroy() end
        appearance.face:Clone().Parent = head
    end
    appearance:Destroy()
    -- restore exact spawn position / velocity after all welding is done
    if hrp and savedCF then
        pcall(function()
            hrp.CFrame = savedCF
            if savedVel then hrp.AssemblyLinearVelocity = savedVel end
            if savedAVel then hrp.AssemblyAngularVelocity = savedAVel end
            hrp.Velocity = savedVel or Vector3.new()
            hrp.RotVelocity = Vector3.new()
        end)
    end
end
getgenv().DoChar = function(username)
    local uid = charGetUserId(username)
    if not uid then warn("char: could not resolve user " .. tostring(username)) return end
    if charRespawnConn then pcall(function() charRespawnConn:Disconnect() end) charRespawnConn = nil end
    task.spawn(function() pcall(charApplyAppearance, uid, LocalPlayer.Character) end)
    charRespawnConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        -- let the server finish placing the new spawn before touching it
        local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
        if hrp then
            local t0 = os.clock()
            pcall(function() hrp:GetPropertyChangedSignal("CFrame"):Wait() end)
            task.wait(0.35)
            -- extra settle so spawn velocity is stable
            if os.clock() - t0 < 0 then task.wait() end
        else
            task.wait(1)
        end
        pcall(charApplyAppearance, uid, newChar)
    end)
end
getgenv().DoUnchar = function()
    if charRespawnConn then pcall(function() charRespawnConn:Disconnect() end) charRespawnConn = nil end
    task.spawn(function() pcall(charApplyAppearance, LocalPlayer.UserId, LocalPlayer.Character) end)
end

