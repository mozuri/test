                                data.boxFill.Visible = true
                                data.boxFill.Position = UDim2.fromOffset(leftX, topY)
                                data.boxFill.Size = UDim2.fromOffset(boxWidth, boxHeight)
                            else
                                data.boxFill.Visible = false
                            end

                            if getgenv().ESPConfig.HealthBar then
                                local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                                local barHeight = boxHeight
                                local barWidth = 3

                                data.hpBG.Visible = true
                                data.hpBG.Position = UDim2.fromOffset(leftX - barWidth - 3, topY)
                                data.hpBG.Size = UDim2.fromOffset(barWidth, barHeight)

                                data.hpFill.Visible = true
                                data.hpFill.Position = UDim2.fromOffset(0, barHeight)
                                data.hpFill.Size = UDim2.fromOffset(barWidth, barHeight * hpPct)
