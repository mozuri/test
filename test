-- Unload Script Button
local unloadBtn = uiSection:Button({ Name = "unload script", Callback = function()
    -- Stop all script work FIRST so nothing re-applies mid-cleanup.
    -- NOTE: configs are DISABLED (not set to nil) so the lingering
    -- Heartbeat/RenderStepped loops go idle instead of error-spamming
    -- every frame (that error spam was the post-unload lag).
    getgenv().CelestiteUnloaded = true
    pcall(syncFlags)

    if getgenv().HoodCustomsConn then
        pcall(function() getgenv().HoodCustomsConn:Disconnect() end)
        getgenv().HoodCustomsConn = nil
    end
    if getgenv().HoodCustomsReloadConn then
        pcall(function() getgenv().HoodCustomsReloadConn:Disconnect() end)
        getgenv().HoodCustomsReloadConn = nil
    end

    pcall(function()
        if getgenv().AimbotConfig then getgenv().AimbotConfig.Enabled = false end
        if getgenv().SilentConfig then getgenv().SilentConfig.Enabled = false end
        if getgenv().ESPConfig then getgenv().ESPConfig.Enabled = false end
        if getgenv().WalkspeedConfig then getgenv().WalkspeedConfig.Enabled = false end
        if getgenv().HeadlessConfig then getgenv().HeadlessConfig.Enabled = false end
        if getgenv().WorldConfig then
            getgenv().WorldConfig.SkyboxEnable = false
            getgenv().WorldConfig.TextureEnable = false
            getgenv().WorldConfig.TimeEnable = false
            getgenv().WorldConfig.SkyboxSpin = false
        end
        if getgenv().AtmosphereConfig then
            getgenv().AtmosphereConfig.Enable = false
            getgenv().AtmosphereConfig.WeatherEnable = false
        end
        if getgenv().CustomSkins then getgenv().CustomSkins.Enable = false end
        if getgenv().HoodCustoms then
            for _, Cfg in pairs(getgenv().HoodCustoms['Skins']) do Cfg['Enabled'] = false end
            if getgenv().HoodCustoms['BeamChanger'] then
                getgenv().HoodCustoms['BeamChanger'].Enabled = false
            end
        end
    end)
    aimbotEnemy = nil
    BeamApplied = nil

    -- Restore custom guns
    pcall(function()
        for tool, _ in pairs(CustomGunState) do cleanCustomGun(tool) end
        CustomGunState = {}
        local ch = LocalPlayer.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") then pcall(cleanCustomGun, t) end
            end
        end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then pcall(cleanCustomGun, t) end
            end
        end
    end)

    -- Restore hood customs skins
    pcall(function()
        local ch = LocalPlayer.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") then HoodRestoreSkin(t) end
            end
        end
    end)

    -- Restore movement FIRST (this was the "cant move" bug: speed was
    -- never reliably reset because the config was nilled while the
    -- speed loop was still running/erroring).
    pcall(function()
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end)
    if speedConnection then pcall(function() speedConnection:Disconnect() end) end
    pcall(function()
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end)

    -- Restore head
    pcall(function()
        local c = LocalPlayer.Character
        local head = c and c:FindFirstChild("Head")
        if head then
            if originalHeadTransparency ~= nil then head.Transparency = originalHeadTransparency end
            local face = head:FindFirstChild("face")
            if face and originalFaceTransparency ~= nil then face.Transparency = originalFaceTransparency end
        end
    end)

    -- Restore map materials
    pcall(function()
        for part, origMat in pairs(originalMaterials) do
            if part and part.Parent then pcall(function() part.Material = origMat end) end
        end
        originalMaterials = {}
    end)

    -- Restore sky / time / atmosphere / weather (loops above go idle
    -- and finish the restore themselves, but force it here too)
    pcall(function()
        local ours = ourSky()
        if ours then ours:Destroy() end
        if savedSky then
            local sky = Instance.new("Sky")
            sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = savedSky.Bk, savedSky.Dn, savedSky.Ft
            sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = savedSky.Lf, savedSky.Rt, savedSky.Up
            sky.Parent = Lighting
            savedSky = nil
        end
        lastSky = nil
    end)
    pcall(function()
        if originalTime ~= nil then Lighting.ClockTime = originalTime end
        originalTime = nil
    end)
    pcall(function()
        local a = Lighting:FindFirstChild("CelestiteAtmo")
        if a then a:Destroy() end
        originalAtmosphere = nil
    end)
    pcall(function() weatherTeardown() end)

    -- Clear ESP chams + hide drawings
    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then espRemoveCham(plr.Character) end
        end
        for _, data in pairs(ESPCache) do espHideAll(data) end
        if aimbotCircle then aimbotCircle.Visible = false end
        if silentCircle then silentCircle.Visible = false end
    end)
    pcall(function()
        if aimbotCircle then aimbotCircle:Remove() end
    end)
    pcall(function()
        if silentCircle then silentCircle:Remove() end
    end)

    -- Show notification before destroying
    pcall(function() Library:Notification({ Text = "Script unloaded successfully!", Duration = 2 }) end)

    -- Hide and destroy GUI (no long wait = no input freeze)
    if mainWindow then
        pcall(function() mainWindow.Visible = false end)
    end
    task.spawn(function()
        task.wait(0.6)
        pcall(function()
            local ch = LocalPlayer.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
        end)
        if ScreenGui then
            pcall(function() ScreenGui:Destroy() end)
        end
        if espGui then
            pcall(function() espGui:Destroy() end)
        end
    end)
end })

