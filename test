            function cfg.set_visible(bool)
                items[ "dropdown_holder" ].Visible = bool 
                items[ "arrow" ].Rotation = bool and 180 or 0

                -- parent to the window frame so an open list follows window drags
                local win = items.dropdown_outline
                while win and win.Parent ~= library.items do
                    win = win.Parent
                end

                local ow = items.dropdown_outline.AbsoluteSize.X
                local oh = items.dropdown_outline.AbsoluteSize.Y
                local ox, oy = items.dropdown_outline.AbsolutePosition.X, items.dropdown_outline.AbsolutePosition.Y
                if win then
                    items[ "dropdown_holder" ].Parent = win
                    items[ "dropdown_holder" ].Position = dim2(0, ox - win.AbsolutePosition.X, 0, oy - win.AbsolutePosition.Y + oh + 4)
                else
                    items[ "dropdown_holder" ].Parent = library.items
                    items[ "dropdown_holder" ].Position = dim2(0, ox, 0, oy + oh + 4)
                end
                items[ "dropdown_holder" ].Size = dim2(0, ow, 0, 0)

                -- clamp tall option lists (e.g. 38 skins) to a scrollable 180px
                if bool then
                    task.spawn(function()
                        task.wait()
                        pcall(function()
                            local content = items.dropdown_shading.AbsoluteSize.Y + 2
                            items.dropdown_holder.Size = dim2(0, ow, 0, clamp(content, 20, 180))
                            items.dropdown_holder.CanvasPosition = Vector2.new(0, 0)
                        end)
                    end)
                end
                
                library.current = cfg
            end
            
            function cfg.set(value)
                local selected = {}
                local isTable = type(value) == "table"

                for _, option in cfg.option_instances do 
                    if option.Text == value or (isTable and find(value, option.Text)) then 
                        insert(selected, option.Text)
                        cfg.multi_items = selected
                        option.TextColor3 = rgb(147, 197, 253)
                    else
                        option.TextColor3 = rgb(174, 174, 174)
                    end
                end

                items.inner_text.Text = if isTable then concat(selected, ", ") else selected[1] or ""
                flags[cfg.flag] = if isTable then selected else selected[1]
                
                cfg.callback(flags[cfg.flag]) 
            end
            
            function cfg.refresh_options(list) 
                for _, option in cfg.option_instances do 
                    option:Destroy() 
                end
                
                cfg.option_instances = {} 

                for _, option in list do 
                    local button = cfg.render_option(option)
                    insert(cfg.option_instances, button)
                    
                    button.MouseButton1Down:Connect(function()
                        if cfg.multi then 
                            local selected_index = find(cfg.multi_items, button.Text)
                            
                            if selected_index then 
