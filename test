local origMousePos = Vector2.new(0, 0)
local silentMouse = nil

local function isTeammate(plr)
    if not LocalPlayer.Team or not plr.Team then return false end
    return LocalPlayer.Team == plr.Team
end

local function hasFF(char)
    return char and char:FindFirstChildOfClass("ForceField") ~= nil
end

local function isVisibleToCam(char, part)
    local cam = Camera
    if not cam then return true end
    local origin = cam.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local res = Workspace:Raycast(origin, (part.Position - origin).Unit * 5000, params)
    if not res then return true end
    return res.Instance:IsDescendantOf(char)
end

local function getSilentPart()
    local cam = Camera
    if not cam then return nil end

    -- Use aimbot's current target if requested (EXCLUSIVE: only this
    -- target, never fall back to anyone else while the toggle is on).
    if getgenv().SilentConfig.UseAimbotTarget then
        if typeof(aimbotEnemy) == "Instance" and aimbotEnemy.Parent then
            local char = aimbotEnemy.Parent
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local plr = nil
            pcall(function() plr = Players:GetPlayerFromCharacter(char) end)
            if plr and plr ~= LocalPlayer and not isTeammate(plr)
               and hum and not targetDead(char, hum)
               and not hasFF(char) then
                if not getgenv().SilentConfig.VisibleCheck or isVisibleToCam(char, aimbotEnemy) then
                    return aimbotEnemy
                end
            end
        end
        return nil
    end

    local useFOV = getgenv().SilentConfig.UseFOV
    local fovR = useFOV and (getgenv().SilentConfig.FOVSize or 200) or math.huge

    local best, bestD = nil, fovR
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isTeammate(plr) then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0
                   and not (getgenv().SilentConfig.KnockCheck and downed(char))
                   and not hasFF(char) then
                    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if part then
                        if not getgenv().SilentConfig.VisibleCheck or isVisibleToCam(char, part) then
                            local pos, onScreen = cam:WorldToScreenPoint(part.Position)
                            if onScreen then
                                local d = (Vector2.new(pos.X, pos.Y) - origMousePos).Magnitude
                                if d < bestD then
                                    bestD = d
                                    best = part
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Lead for one part, computed FRESH on every call: caching the position
-- snapshot is what made silent miss movers (head already gone when the
-- shot fires). Same responsiveness feel as aimbot: 0 = little lead.
local function predictForPart(part)
    if not part or not part.Parent then return nil, nil end
    local char = part.Parent
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if targetDead(char, hum) then return nil, nil end
    local center = part.Position
    if not getgenv().SilentConfig.PredEnable then return part, center end
    local px = (getgenv().SilentConfig.PredX or 0) / 100
    local py = (getgenv().SilentConfig.PredY or 0) / 10
    local scale = math.clamp((getgenv().SilentConfig.PredX or 0) / 20, 0, 1)
    if px <= 0 then
        if py ~= 0 then center = center + Vector3.new(0, py, 0) end
        return part, center
    end
    local vel = targetVelocity(char, part)
    local air = targetAirBoost(char, vel.Y)
    -- lead fast toward the side they're moving when airborne
    local mult = (0.25 + 0.75 * scale) * (1 + air * 1.5)
    return part, predictPos(part, char, center, px, mult, py)
end

local function getSilentAim()
    return predictForPart(getSilentPart())
end

local function getSilentXY(which)
    local cam = Camera
    if not cam then return nil end
    local part, aimPos = getSilentAim()
    if not part or not aimPos then return nil end
    local pos, onScreen = cam:WorldToScreenPoint(aimPos)
    if not onScreen then return nil end
    return which == "X" and pos.X or pos.Y
end

-- Per-shot target lock: GetAim runs up to 5x + Shoot 5x + namecall for one
-- shotgun blast within milliseconds. The TARGET stays locked for 0.06s so
-- pellets don't scatter across people, but the POSITION is re-predicted
-- live on every call (predictForPart) so movers don't dodge stale data.
local silentCache = { t = -99, part = nil }
local function getSilentAimCached()
    local now = os.clock()
    if now - silentCache.t < 0.06 and silentCache.part and silentCache.part.Parent then
        local part, pos = predictForPart(silentCache.part)
        if part and pos then return part, pos end
    end
    local part, pos = getSilentAim()
    if part and pos then silentCache.t, silentCache.part = now, part end
    return part, pos
end

-- Pellet fan dial (silent "spread size" slider, 0..10 -> 0..0.5 studs).
-- Each pellet gets its own disc point around the head for BOTH Aim and
-- Result - identical points always pass validation, mismatched pairs got
-- rejected. 0 = exact-center laser (always damages). Raise slowly to find
-- the biggest fan your server still accepts.
local function silentSpreadPos(aimPos, origin)
    local studs = 0
    pcall(function() studs = tonumber(getgenv().SilentConfig.Spread) or 0 end)
    if not studs or studs <= 0 then return aimPos end
    local ok, res = pcall(function()
        local dir = (aimPos - origin).Unit
        local right = dir:Cross(Vector3.new(0, 1, 0))
        if right.Magnitude < 0.01 then right = Camera.CFrame.RightVector end
        right = right.Unit
        local up = right:Cross(dir).Unit
        local a = math.random() * math.pi * 2
        local r = math.sqrt(math.random()) * studs
        return aimPos + right * math.cos(a) * r + up * math.sin(a) * r
    end)
    if ok and typeof(res) == "Vector3" then return res end
    return aimPos
end

-- Master gate: silent redirects ONLY when explicitly turned on.
-- (The FOV circle showing is NOT silent being on.)
local function silentOn()
    if getgenv().CelestiteUnloaded then return false end
    local cfg = getgenv().SilentConfig
    if not cfg or cfg.Enabled ~= true then return false end
    local f = Library.Flags and Library.Flags["silent_enable"]
    if f and f.GetState then
        local ok, st = pcall(function() return f:GetState() end)
        if ok and not st then return false end
    end
    return true
end

