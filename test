                        if getgenv().ESPConfig.Radar then
                            local relPos = hrp.Position - camPos
                            local relFlat = Vector3.new(relPos.X, 0, relPos.Z)
                            local dotRight = relFlat:Dot(rightFlat)
                            local dotForward = relFlat:Dot(camFlat)

                            local scale = (getgenv().ESPConfig.RadarSize / 2) / getgenv().ESPConfig.RadarRange
                            local rx = math.clamp(dotRight * scale, -getgenv().ESPConfig.RadarSize / 2 + 4, getgenv().ESPConfig.RadarSize / 2 - 4)
                            local ry = math.clamp(-dotForward * scale, -getgenv().ESPConfig.RadarSize / 2 + 4, getgenv().ESPConfig.RadarSize / 2 - 4)

                            data.dot.Visible = true
                            data.dot.Position = UDim2.new(0.5, rx, 0.5, ry)
                        else
                            data.dot.Visible = false
                        end

                        if getgenv().ESPConfig.Arrows then
                            local dirFlat = Vector3.new(hrp.Position.X - camPos.X, 0, hrp.Position.Z - camPos.Z)
                            if dirFlat.Magnitude > 0.1 then
                                dirFlat = dirFlat.Unit
                                local dotRight = dirFlat:Dot(rightFlat)
                                local dotForward = dirFlat:Dot(camFlat)
                                local relAngle = math.deg(math.atan2(dotRight, dotForward))

                                arrowIndex = arrowIndex + 1
                                local arrow = espGetArrow(arrowIndex)
                                arrow.Visible = true
                                local rad = math.rad(relAngle)
                                local ax = math.sin(rad) * 120
                                local ay = -math.cos(rad) * 120
                                arrow.Position = UDim2.new(0.5, ax, 0.5, ay)
                                arrow.Size = UDim2.fromOffset(20, 20)
                                arrow.Rotation = relAngle
                            end
                        end
                    end
                end
            end
        end
    end

    for i = arrowIndex + 1, #espArrowPool do
        espArrowPool[i].Visible = false
    end
end)

-- WALKSPEED ENGINE
local isSpeedEnabled = false
local defaultSpeed = 16
local crouchSpeed = 8

local function isCrouching()
    -- Robust check: Da Hood stores the flag in different spots depending on
    -- version (workspace player node, "players" folder, or the Character
    -- itself) with inconsistent casing. Check all of them so we never miss
    -- it (a missed detection was forcing WalkSpeed 16/300 while crouched,
    -- i.e. faster than the real 8 crouch speed).
    local function findCrouchFlag(root)
        if not root then return nil end
        local be = root:FindFirstChild("BodyEffects") or root:FindFirstChild("bodyeffects")
        if not be then
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BoolValue") and d.Name:lower() == "crouching" then
                    return d.Value
                end
            end
            return nil
        end
        local c = be:FindFirstChild("Crouching") or be:FindFirstChild("crouching")
        if c and c:IsA("BoolValue") then return c.Value end
        return nil
    end
    local char = LocalPlayer.Character
    do
        local v = findCrouchFlag(char)
        if v ~= nil then return v end
    end
    local name = LocalPlayer.Name
    do
        local v = findCrouchFlag(workspace:FindFirstChild(name))
        if v ~= nil then return v end
    end
    local players = workspace:FindFirstChild("players")
    if players then
        local v = findCrouchFlag(players:FindFirstChild(name))
        if v ~= nil then return v end
    end
    return false
end

local speedWasEnabled = false
local function updateSpeed()
    if getgenv().CelestiteUnloaded then return end
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- When disabled: do NOT touch WalkSpeed every frame.
    -- The old code forced 16/8 here, which overwrote the game's sprint
    -- (sprint sets WalkSpeed higher) so you could never sprint.
    if not getgenv().WalkspeedConfig.Enabled then
        if speedWasEnabled then
            speedWasEnabled = false
            -- restore once after turning speed off, then let game/sprint take over
            pcall(function() humanoid.WalkSpeed = defaultSpeed end)
        end
        return
    end
