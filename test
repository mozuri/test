local function espNewLine(parent, color)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Visible = false
    f.Parent = parent
    return f
end

local function espSetLine(line, fromPos, toPos, thickness)
    if not fromPos or not toPos then
        line.Visible = false
        return
    end
    local dist = (toPos - fromPos).Magnitude
    local mid = (fromPos + toPos) / 2
    local angle = math.deg(math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X))
    line.Position = UDim2.fromOffset(mid.X, mid.Y)
    line.Size = UDim2.fromOffset(dist, thickness or 1)
    line.Rotation = angle
    line.Visible = true
end

