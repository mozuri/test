    end
    local OldNC
    OldNC = hookmetamethod(game, "__namecall", (newcclosure and newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local cc = (checkcaller and checkcaller()) or false
        if not cc and method == "FireServer" and self.Name == "MainRemoteEvent" then
            local a = {...}
            if a[1] == "ShootGun" and silentOn() then
                local part, aimPos = getSilentAimCached()
                if part and part.Parent and aimPos then
                    -- shotgun: a[4] = PelletData table
                    -- Aim AND Result must agree. The old code kept the
                    -- original spread AimPosition and only spoofed Result,
                    -- Fan dial: ONE fan point per pellet, written into BOTH
                    -- AimPosition and Result1. Identical points validate;
                    -- spread 0 = exact head center (the proven laser).
