                        else
                            espRemoveCham(char)
                        end

                        local topScreen = espWorldToScreen(hrp.Position + Vector3.new(0, 3, 0))
                        local bottomScreen = espWorldToScreen(hrp.Position - Vector3.new(0, 3, 0))
                        local headScreen = head and espWorldToScreen(head.Position)

                        if topScreen and bottomScreen then
                            local boxHeight = math.abs(bottomScreen.Y - topScreen.Y)
                            local boxWidth = boxHeight * 0.55
                            local centerX = (topScreen.X + bottomScreen.X) / 2
                            local centerY = (topScreen.Y + bottomScreen.Y) / 2
                            local topY = centerY - boxHeight / 2
                            local bottomY = centerY + boxHeight / 2
                            local leftX = centerX - boxWidth / 2
                            local rightX = centerX + boxWidth / 2

                            if getgenv().ESPConfig.Box then
                                espSetLine(data.boxTop, Vector2.new(leftX, topY), Vector2.new(rightX, topY), 1)
                                espSetLine(data.boxBottom, Vector2.new(leftX, bottomY), Vector2.new(rightX, bottomY), 1)
                                espSetLine(data.boxLeft, Vector2.new(leftX, topY), Vector2.new(leftX, bottomY), 1)
                                espSetLine(data.boxRight, Vector2.new(rightX, topY), Vector2.new(rightX, bottomY), 1)
