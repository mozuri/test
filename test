local function highlightRows()
    for _, r in ipairs(playerRows) do
        pcall(function()
            r.name.TextColor3 = (r.userId == selectedUserId) and rgb(147, 197, 253) or rgb(178, 178, 178)
        end)
    end
end

local function filterRows(q)
    q = string.lower(tostring(q or ""))
    for _, r in ipairs(playerRows) do
        local show = (q == "") or string.find(r.d, q, 1, true) or string.find(r.u, q, 1, true)
        pcall(function() r.button.Visible = show and true or false end)
    end
end

local function tagText(uid)
    local PL = getgenv().PlayerList
    if not PL then return "" end
    local s = ""
    if PL.Whitelist[uid] then s = s .. '<font color="#7DFF7D">W</font> ' end
    if PL.ForcedTarget == uid then s = s .. '<font color="#93C5FD">T</font> ' end
    if PL.Priority[uid] then s = s .. '<font color="#FFD75D">P</font> ' end
    if PL.WallOverride[uid] then s = s .. '<font color="#C9A7FF">WC</font>' end
    return s
end

local function refreshTags()
    for _, r in ipairs(playerRows) do
        pcall(function() r.tag.Text = tagText(r.userId) end)
    end
end

local tglTarget, tglPriority, tglWhitelist, tglWall
local infoAvatar, infoName, infoUser

local function selectPlayer(uid)
    local plr = nil
    pcall(function() plr = players:GetPlayerByUserId(uid) end)
    if not plr then return end
    selectedUserId = uid
    highlightRows()
    local PL = getgenv().PlayerList
    pcall(function() infoAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. uid .. "&w=180&h=180" end)
    infoName.set(plr.DisplayName)
    infoUser.set("@" .. plr.Name .. "  (" .. uid .. ")")
    tglTarget.set(PL.ForcedTarget == uid)
    tglPriority.set(PL.Priority[uid] == true)
    tglWhitelist.set(PL.Whitelist[uid] == true)
    tglWall.set(PL.WallOverride[uid] == true)
    refreshTags()
end

local function makeRow(plr)
    local btn = library:create("TextButton", {
        Parent = plist_left.items.elements;
        Size = dim2(1, 0, 0, 30);
        BackgroundTransparency = 1;
        Text = "";
        AutoButtonColor = false;
        BorderSizePixel = 0;
        BackgroundColor3 = rgb(20, 20, 20)
    })
    local av = library:create("ImageLabel", {
        Parent = btn;
        BackgroundTransparency = 1;
        Position = dim2(0, 4, 0.5, -11);
        Size = dim2(0, 22, 0, 22);
        BorderSizePixel = 0;
        BackgroundColor3 = rgb(255, 255, 255);
        Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=48&h=48"
    })
    library:create("UICorner", { Parent = av; CornerRadius = dim(1, 0) })
    local nm = library:create("TextLabel", {
        Parent = btn;
        BackgroundTransparency = 1;
        Position = dim2(0, 32, 0, 0);
        Size = dim2(1, -104, 1, 0);
        FontFace = library.font;
        TextSize = 10;
        TextXAlignment = Enum.TextXAlignment.Left;
        TextTruncate = Enum.TextTruncate.AtEnd;
        TextColor3 = rgb(178, 178, 178);
        BorderSizePixel = 0;
        BackgroundColor3 = rgb(255, 255, 255);
        Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
    })
    library:create("UIStroke", { Parent = nm })
    local tag = library:create("TextLabel", {
        Parent = btn;
        BackgroundTransparency = 1;
        RichText = true;
        Position = dim2(1, -68, 0, 0);
        Size = dim2(0, 64, 1, 0);
        FontFace = library.font;
        TextSize = 10;
        TextXAlignment = Enum.TextXAlignment.Right;
        TextColor3 = rgb(178, 178, 178);
        BorderSizePixel = 0;
        BackgroundColor3 = rgb(255, 255, 255);
        Text = ""
    })
    btn.MouseButton1Click:Connect(function() selectPlayer(plr.UserId) end)
    btn.MouseEnter:Connect(function()
        if plr.UserId ~= selectedUserId then
            library:tween(nm, {TextColor3 = rgb(230, 230, 230)})
        end
    end)
    btn.MouseLeave:Connect(function()
        if plr.UserId ~= selectedUserId then
            library:tween(nm, {TextColor3 = rgb(178, 178, 178)})
        end
    end)
    return { button = btn, name = nm, tag = tag, userId = plr.UserId, d = string.lower(plr.DisplayName), u = string.lower(plr.Name) }
end

local function rebuildList()
    for _, r in ipairs(playerRows) do
        pcall(function() r.button:Destroy() end)
    end
    playerRows = {}
    local stillHere = false
    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= lp then
            table.insert(playerRows, makeRow(plr))
            if plr.UserId == selectedUserId then stillHere = true end
        end
    end
    if not stillHere then
        selectedUserId = nil
        if getgenv().Spectate and getgenv().Spectate.uid then
            getgenv().Spectate.uid = nil
            pcall(function()
                local cam = ws.CurrentCamera
                local me = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if cam and me then cam.CameraSubject = me end
                if cam then cam.CameraType = Enum.CameraType.Custom end
            end)
            pcall(function() spectateBtn.items.button_text.Text = "spectate" end)
        end
        pcall(function() infoAvatar.Image = "" end)
        infoName.set("-")
        infoUser.set("-")
        tglTarget.set(false)
        tglPriority.set(false)
        tglWhitelist.set(false)
        tglWall.set(false)
    end
    local q = ""
    pcall(function() q = flags["plist_search"] or "" end)
    filterRows(q)
    highlightRows()
    refreshTags()
end

