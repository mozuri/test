local silentCircle = nil
if HAS_DRAWING then
    pcall(function()
        silentCircle = Drawing.new("Circle")
        silentCircle.Color = Color3.fromRGB(147, 197, 253)
        silentCircle.Thickness = 2
        silentCircle.Filled = false
        silentCircle.Visible = false
    end)
