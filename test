                                end
                                pellet.AimPosition = target
                                pellet.Result1 = target
                                pellet.Result2 = part
                                pellet.Result3 = Vector3.new(0, 1, 0)
                            end
                        end
                    end
                    -- revolver single: a[5],a[6],a[7] = R1(pos),R2(inst),R3(norm)
