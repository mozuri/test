local function downed(char)
    if not char or typeof(char) ~= "Instance" then return false end
    local ok, res = pcall(function()
        local be = char:FindFirstChild("BodyEffects")
        if be then
            local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
            if ko then
                local okV, v = pcall(function() return ko.Value end)
                if okV and (v == true or v == 1) then return true end
            end
            local d = be:FindFirstChild("Downed")
            if d then
                local okV2, v2 = pcall(function() return d.Value end)
                if okV2 and (v2 == true or v2 == 1) then return true end
            end
        end
        return false
    end)
    return ok and res or false
end

-- Unconditional dead check for the CURRENT lock. Da Hood KO keeps
-- Humanoid.Health above 0, so this must NOT be gated behind KnockCheck
-- (KnockCheck only controls acquiring NEW knocked targets in valid()).
local function targetDead(ch, hum)
    if not ch or not hum then return true end
    local okH, hp = pcall(function() return hum.Health end)
    if not okH or not hp or hp <= 0 then return true end
    local okS, st = pcall(function() return hum:GetState() end)
    if okS and st == Enum.HumanoidStateType.Dead then return true end
    if downed(ch) then return true end
    return false
end

-- Shared target motion helpers (aimbot + silent prediction)
local function targetVelocity(char, part)
    local ok, v = pcall(function()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.AssemblyLinearVelocity end
        return part.AssemblyLinearVelocity
    end)
    if ok and typeof(v) == "Vector3" then return v end
    local ok2, v2 = pcall(function() return part.Velocity end)
    if ok2 and typeof(v2) == "Vector3" then return v2 end
    return Vector3.new()
end

-- 0 = grounded/slow, 1 = fast airborne. vy alone misses jump apex
-- (vy ~ 0 at the top), so the Humanoid state floors airborne to 0.45.
local function targetAirBoost(char, velY)
    local j = math.clamp(((math.abs(velY or 0)) - 6) / 50, 0, 1) -- Balanced sensitivity
    local ok, air = pcall(function()
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Jumping
            or st == Enum.HumanoidStateType.Freefall
            or st == Enum.HumanoidStateType.FallingDown then
            return true
        end
        return hum.FloorMaterial == Enum.Material.Air
    end)
    if ok and air then j = math.max(j, 0.45) end -- Standard floor for airborne state
    return j
end

-- leadTime = base seconds from the pred slider + small travel-time comp
-- by distance (farther = longer flight = more lead), capped at 0.35s.
local function predictPos(part, char, center, leadTime, leadMult, upAdd)
    local ok, res = pcall(function()
        local vel = targetVelocity(char, part)
        local camP = Camera.CFrame.Position
        local dist = (center - camP).Magnitude
        local t = math.clamp(leadTime + dist / 1500, 0, 0.35)
        return center + vel * (t * leadMult) + Vector3.new(0, upAdd or 0, 0)
    end)
    if ok and typeof(res) == "Vector3" then return res end
    return center
end

local function see(camPos, part, me, them)
    local dir = part.Position - camPos
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = { me, them }
    p.IgnoreWater = true
    local hit = Workspace:Raycast(camPos, dir, p)
    return hit == nil
end

local function valid(plr, part)
    if not plr or plr == LocalPlayer then return false end
    local PLv = getgenv().PlayerList
    if PLv then
        if PLv.Whitelist[plr.UserId] then return false end
    end
    local ch = plr.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if getgenv().AimbotConfig.KnockCheck and downed(ch) then return false end
    return true
end

-- shared hitpart picker (vanilla UI Hitpart dropdown; Random supported)
local function pickPartFor(char)
    if not char then return nil end
    local want = tostring(getgenv().AimbotConfig.Hitpart or "Head")
    local part = nil
    if want == "Random" then
        local pool = {}
        for _, n in ipairs({"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Torso"}) do
            local p = char:FindFirstChild(n)
            if p then pool[#pool + 1] = p end
        end
        if #pool > 0 then part = pool[math.random(1, #pool)] end
    else
        part = char:FindFirstChild(want)
    end
    if not part then
        part = char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
    end
    return part
end

-- per-player wall rule: override wins, otherwise the global VisibleCheck
local function wallOkFor(plr, part)
    local ov = getgenv().PlayerList and getgenv().PlayerList.WallOverride[plr.UserId]
    if ov == false then return true end
    if ov ~= true and not getgenv().AimbotConfig.VisibleCheck then return true end
    local okV = false
    pcall(function()
        okV = see(Camera.CFrame.Position, part, LocalPlayer.Character, part.Parent)
    end)
    return okV
end

local function findTarget(maxDist)
    local cam = Camera
    if not cam then return nil end
    local res = GuiService:GetScreenResolution()
    local cx, cy = res.X / 2, res.Y / 2
    local best, bestD = nil, maxDist or math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local part = pickPartFor(plr.Character)
            if part and valid(plr, part) then
                local pos, vis = cam:WorldToViewportPoint(part.Position)
                if vis then
                    local d = (Vector2.new(pos.X, pos.Y) - Vector2.new(cx, cy)).Magnitude
                    if d < bestD then
                        bestD = d
                        best = part
                    end
                end
            end
        end
    end
    return best, (best and bestD or math.huge)
end

local function nearest()
    local lim = math.huge
    if getgenv().AimbotConfig.UseFOV then lim = getgenv().AimbotConfig.FOVSize end
    local PLn = getgenv().PlayerList
    -- forced Target: only this player, nothing else
    if PLn and PLn.ForcedTarget then
        local fplr = nil
        pcall(function() fplr = Players:GetPlayerByUserId(PLn.ForcedTarget) end)
        if fplr and fplr ~= LocalPlayer and fplr.Character then
            local fpart = pickPartFor(fplr.Character)
            if fpart and valid(fplr, fpart) and wallOkFor(fplr, fpart) then
                return fpart, 0
            end
        end
        return nil, math.huge
    end
    -- high priority players win over the normal pool
    if PLn and PLn.Priority then
        local pb, pd = nil, lim
        for uid in pairs(PLn.Priority) do
            local pp = nil
            pcall(function() pp = Players:GetPlayerByUserId(uid) end)
            if pp and pp ~= LocalPlayer and pp.Character then
                local ppart = pickPartFor(pp.Character)
                if ppart and valid(pp, ppart) and wallOkFor(pp, ppart) then
                    local pos, vis = Camera:WorldToViewportPoint(ppart.Position)
                    if vis then
                        local rs = GuiService:GetScreenResolution()
                        local dd = (Vector2.new(pos.X, pos.Y) - Vector2.new(rs.X / 2, rs.Y / 2)).Magnitude
                        if dd < pd then pd, pb = dd, ppart end
                    end
                end
            end
        end
        if pb then return pb, pd end
    end
    local best, bestD = findTarget(lim)
    if not best then
        -- Crosshair bypass: someone already under your crosshair locks
        -- even past the FOV edge, so it never feels like "no lock".
        best, bestD = findTarget(25)
    end
    return best, (best and bestD or math.huge)
end

-- Someone basically on the crosshair (valid, on screen). Used to let
-- intentional aims through the post-kill cooldown.
local function nearCrosshair()
    local best = findTarget(25)
    if best then
        local ncPlr = nil
        pcall(function() ncPlr = Players:GetPlayerFromCharacter(best.Parent) end)
        if ncPlr and not wallOkFor(ncPlr, best) then return nil end
    end
    return best
end

local rescan = 0
-- Post-kill cooldown: after YOUR locked target dies, never insta-snap onto
-- the next person. New targets only unlock after this expires.
local killLockUntil = 0
local KILL_LOCK_TIME = 0.8
-- Flicker guard: consecutive invalid frames before a LIVE lock is dropped.
-- (Dead targets bypass this entirely - kills still unlock instantly.)
local missCount = 0
local LOCK_GRACE_FRAMES = 5
-- SCHIZO overflick state (persistent across frames): the aim point flies
-- PAST the target, holds out there briefly, then violently snaps back with
-- a hard opposite-side correction. That is what makes it read as manic
-- overflicking instead of a center-shake.
local schizoNextFlickAt = 0
local schizoFlickUntil = 0
local schizoFlickDX, schizoFlickDY = 0, 0
-- smooth flick attack: targets + ramp start/duration (no per-frame random,
-- everything eases so there is zero vibration/shake between flicks)
-- schizoLean: eased lateral offset angle, drives the weapon tilt smoothly
local schizoLean = 0
local schizoFlickTX, schizoFlickTY = 0, 0
local schizoFlickStart, schizoFlickRamp = 0, 0.06
-- smooth correction bump: targets + window (sine envelope in/out, no pops)
local schizoCorrectStart, schizoCorrectEnd = 0, 0
local schizoCorrectUntil = 0
local schizoCorrectDX, schizoCorrectDY = 0, 0

-- Keybind handler for aimbot (removed - now handled by UI keybind system)

RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        if aimbotCircle then
            local res = GuiService:GetScreenResolution()
            aimbotCircle.Position = Vector2.new(res.X / 2, res.Y / 2)
            aimbotCircle.Radius = getgenv().AimbotConfig.FOVSize
            aimbotCircle.Visible = getgenv().AimbotConfig.ShowFOV
        end
    end)
    
    local on = getgenv().AimbotConfig.Enabled
    if on and not aimbotEnemy then
        if os.clock() >= killLockUntil then
            aimbotEnemy = nearest()
            rescan = 0
        else
            -- Cooldown blocks auto-snaps. With knock check enabled, don't lock
            -- to nearest on crosshair - just deactivate aimbot.
            if not getgenv().AimbotConfig.KnockCheck then
                local nc = nearCrosshair()
                if nc then aimbotEnemy = nc; rescan = 0 end
            end
        end
    end
    if not on then
        aimbotEnemy = nil
        return
    end
    
    local e = aimbotEnemy
    local targetExists = (typeof(e) == "Instance") and (e.Parent ~= nil)
    -- Kill / leave: sticky ON locks off (press button again for next).
    -- Either way, a short cooldown blocks insta-snapping onto someone else.
    -- A destroyed/removed target must clear even for sticky, otherwise
    -- aimbotEnemy stays non-nil forever and never re-acquires.
    if not targetExists then
        if e ~= nil then
            aimbotEnemy = nil
            e = nil
            killLockUntil = os.clock() + KILL_LOCK_TIME
            if getgenv().AimbotConfig.Sticky then
                getgenv().AimbotConfig.Enabled = false
                if vanillaRefs.aimbotToggle then pcall(function() vanillaRefs.aimbotToggle.set(false) end) end
                return
            end
            rescan = 99
        end
    else
        local ch = e.Parent
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local plr = nil
        pcall(function() plr = Players:GetPlayerFromCharacter(ch) end)
        if targetDead(ch, hum) or (not plr) then
            aimbotEnemy = nil
            e = nil
            targetExists = false
            killLockUntil = os.clock() + KILL_LOCK_TIME
            -- With knock check enabled, deactivate aimbot on kill instead of re-acquiring
            if getgenv().AimbotConfig.KnockCheck then
                getgenv().AimbotConfig.Enabled = false
                if vanillaRefs.aimbotToggle then pcall(function() vanillaRefs.aimbotToggle.set(false) end) end
                return
            end
            if getgenv().AimbotConfig.Sticky then
                getgenv().AimbotConfig.Enabled = false
                if vanillaRefs.aimbotToggle then pcall(function() vanillaRefs.aimbotToggle.set(false) end) end
                return
            end
            rescan = 99 -- re-acquire only after the kill cooldown above
        end
    end
    local ok = false
    if targetExists and e ~= nil then
        local okPlr = nil
        pcall(function() okPlr = Players:GetPlayerFromCharacter(e.Parent) end)
        ok = valid(okPlr, e)
    end
    if ok then
        local lockPlr = nil
        pcall(function() lockPlr = Players:GetPlayerFromCharacter(e.Parent) end)
        if lockPlr and not wallOkFor(lockPlr, e) then
            ok = false
        end
    end
    -- Flicker guard: a live lock that fails a frame or two (occlusion edge,
    -- stream flicker) holds instead of blinking off. Dead targets were
    -- already cleared above, so kill unlocks are never delayed by this.
    if ok then
        missCount = 0
    elseif targetExists and e ~= nil then
        missCount = missCount + 1
        if missCount <= LOCK_GRACE_FRAMES then
            ok = true
        end
    else
        missCount = 0
    end
    local function screenDist(part)
        local c = Camera
        if not c or not part then return math.huge end
        local okP, pPos = pcall(function() return part.Position end)
        if not okP or not pPos then return math.huge end
        local sp, vis = c:WorldToViewportPoint(pPos)
        if not vis then return math.huge end
        local res = GuiService:GetScreenResolution()
        return (Vector2.new(sp.X, sp.Y) - Vector2.new(res.X / 2, res.Y / 2)).Magnitude
    end
    -- Sticky ON: hold the locked target no matter what - FOV is ignored
    -- for a held lock (FOV only limits picking NEW targets in nearest()).
    -- Lock survives target leaving FOV or brief occlusion; only the
    -- dead/leave check above drops it. Never switch targets.
    if getgenv().AimbotConfig.Sticky then
        if not ok then return end
    else
        rescan = rescan + dt
        if not ok then
            if os.clock() < killLockUntil then
                -- Cooldown: stay off. With knock check, don't lock to nearest.
                if not getgenv().AimbotConfig.KnockCheck then
                    local nc = nearCrosshair()
                    if nc then
                        e = nc
                        aimbotEnemy = nc
                        rescan = 0
                        ok = true
                    else
                        e = nil
                        aimbotEnemy = nil
                        rescan = 0
                        ok = false
                    end
                else
                    e = nil
                    aimbotEnemy = nil
                    rescan = 0
                    ok = false
                end
            else
                -- Cooldown expired: only acquire new target if knock check is disabled
                if not getgenv().AimbotConfig.KnockCheck then
                    e = nearest()
                    aimbotEnemy = e
                    rescan = 0
                    ok = e ~= nil
                else
                    e = nil
                    aimbotEnemy = nil
                    rescan = 0
                    ok = false
                end
            end
        elseif rescan > (string.lower(tostring(getgenv().AimbotConfig.SmoothingStyle or "")) == "schizo" and 0.12 or 0.3) then
            -- Hysteresis: stay glued to a valid lock; only steal to a
            -- candidate clearly closer to the crosshair (no more bouncing
            -- between two people every rescan).
            -- schizo switches way faster: checks more often and steals even
            -- when the candidate is only slightly closer (fast side-switch).
            rescan = 0
            if os.clock() >= killLockUntil then
                local cand = nearest()
                if cand and cand ~= e then
                    local curD = screenDist(e)
                    local candD = screenDist(cand)
                    local stealFactor = (string.lower(tostring(getgenv().AimbotConfig.SmoothingStyle or "")) == "schizo") and 0.92 or 0.7
                    if candD < curD * stealFactor then
                        e = cand
                        aimbotEnemy = e
                    end
                end
            end
        end
    end
    if not ok or not e then return end
    
    local cam = Camera
    local tp = e.Position
    -- Motion state once per frame: reused by prediction (lead toward the
    -- side they're moving, boosted when airborne) and by vanilla smoothing.
    local styleNow = string.lower(tostring(getgenv().AimbotConfig.SmoothingStyle or "linear"))
    local chNow = e.Parent
    local velNow = targetVelocity(chNow, e)
    -- always computed: drives air offset + vanilla/schizo air chase
    local airNow = targetAirBoost(chNow, velNow.Y)
    -- schizo only: horizontal strafe speed 0..1 (drives lateral chase)
    -- sensitive to strafes but not overly aggressive
    local latNow = 0
    if styleNow == "schizo" then
        latNow = math.clamp((Vector3.new(velNow.X, 0, velNow.Z).Magnitude - 2) / 20, 0, 1) -- Balanced sensitivity
    end
    -- Prediction slider (INVERTED): 0 = max prediction (most lead),
    -- 20 = min prediction (least lead). 20 behaves ~like old 0 (no lead).
    local predScale = 1
    if getgenv().AimbotConfig.PredEnable then
        -- px is lead time in seconds: 0 -> 0.2s lead, 20 -> 0s lead.
        local rawPredX = math.clamp(tonumber(getgenv().AimbotConfig.PredX) or 0, 0, 20)
        local invPredX = 20 - rawPredX
        local px = invPredX / 100
        local py = (getgenv().AimbotConfig.PredY or 0) / 20
        predScale = math.clamp(invPredX / 20, 0, 1)
        local mult = 0.25 + 0.75 * predScale
        if styleNow == "vanilla" then
            -- vanilla: chase jumps hard toward the side they're moving
            mult = mult * (1 + airNow * 1.5)
        elseif styleNow == "schizo" then
            -- schizo: stupid-fast lead toward strafe AND jump direction
            local chase = math.max(airNow, latNow)
            mult = mult * (1 + chase * 2.5)
        end
        tp = predictPos(e, chNow, tp, px, mult, py)
    end
    -- SCHIZO OVERFLICK: move the AIM POINT itself past the target (world
    -- space, distance-scaled so it reads the same at any range). Flick out
    -- wide -> hold out there -> hard correction back through center to the
    -- opposite side -> settle, over and over. Everything is SMOOTHLY eased
    -- (no per-frame randomness, no high-freq noise): randomness only picks
    -- the next flick's direction/size, motion itself never vibrates.
    if styleNow == "schizo" then
        local now = os.clock()
        -- smoothing slider tames the madness but never calms it:
        -- 0 smooth = full psycho, 100 smooth = still clearly unhinged
        local scx = math.clamp(tonumber(getgenv().AimbotConfig.SmoothX) or 20, 0, 100) / 100
        local scy = math.clamp(tonumber(getgenv().AimbotConfig.SmoothY) or 20, 0, 100) / 100
        local schizoMag = 1.3 - math.clamp((scx + scy) * 0.5, 0, 1) * 0.55
        local camPos0 = cam.CFrame.Position
        local dist0 = (tp - camPos0).Magnitude
        if dist0 < 1 then dist0 = 1 end
        local deg = dist0 * 0.0174533 * schizoMag -- world units per degree at target range
        -- finish an active flick -> smooth correction bump back THROUGH
        -- center to the opposite side (sine envelope: eases in AND out)
        if schizoFlickUntil ~= 0 and now >= schizoFlickUntil then
            schizoFlickUntil = 0
            local fx, fy = schizoFlickTX, schizoFlickTY
            schizoFlickDX, schizoFlickDY = 0, 0
            schizoFlickTX, schizoFlickTY = 0, 0
            local cb = 0.35 + math.random() * 0.2
            schizoCorrectDX, schizoCorrectDY = -fx * cb, -fy * cb
            schizoCorrectStart = now
            schizoCorrectEnd = now + 0.10 + math.random() * 0.06
            schizoCorrectUntil = schizoCorrectEnd
        end
        if schizoCorrectUntil ~= 0 and now >= schizoCorrectUntil then
            schizoCorrectUntil = 0
            schizoCorrectDX, schizoCorrectDY = 0, 0
        end
        -- trigger a new manic flick: mostly hard horizontal, sometimes wild vertical
        if schizoFlickUntil == 0 and schizoCorrectUntil == 0 and now >= schizoNextFlickAt then
            local horiz = math.random() < 0.65
            local side = (math.random() < 0.5) and -1 or 1
            local fDeg = 8 + math.random() * 10 -- 8-18 degrees past the target
            if horiz then
                schizoFlickTX = side * deg * fDeg
                schizoFlickTY = (math.random() - 0.5) * deg * (2 + math.random() * 5)
            else
                schizoFlickTX = (math.random() - 0.5) * deg * (2 + math.random() * 6)
                schizoFlickTY = side * deg * (6 + math.random() * 9)
            end
            schizoFlickStart = now
            schizoFlickRamp = 0.06 + math.random() * 0.04 -- fast but smooth attack
            schizoFlickUntil = now + schizoFlickRamp + 0.10 + math.random() * 0.08 -- ramp + hold PAST the target
            schizoNextFlickAt = now + 0.80 + math.random() * 0.80 -- readable gaps: flick, settle, flick
        end
        -- eased flick attack: 0 -> full target (ease-out cubic, no step pop)
        local flickX, flickY = 0, 0
        if schizoFlickUntil ~= 0 then
            local p = math.clamp((now - schizoFlickStart) / math.max(schizoFlickRamp, 0.001), 0, 1)
            local ease = 1 - (1 - p) * (1 - p) * (1 - p)
            flickX, flickY = schizoFlickTX * ease, schizoFlickTY * ease
        end
        -- eased correction bump: rises through center to the opposite side,
        -- then settles back to 0 (sine envelope, zero pops at either end)
        local corrX, corrY = 0, 0
        if schizoCorrectUntil ~= 0 then
            local cp = math.clamp((now - schizoCorrectStart) / math.max(schizoCorrectEnd - schizoCorrectStart, 0.001), 0, 1)
            local env = math.sin(math.pi * cp)
            corrX, corrY = schizoCorrectDX * env, schizoCorrectDY * env
        end
        local right0 = cam.CFrame.RightVector
        local up0 = cam.CFrame.UpVector
        -- gentle SMOOTH wander between flicks: slow, small, clean tracking.
        -- (this used to be big layered swings + drift -- that constant
        -- wobble is exactly what read as shaking, so it is kept tiny now.
        -- the madness comes from the discrete flicks, not the in-between.)
        local swingAmp = deg * 0.8
        local swingX = math.sin(now * 2.2) * swingAmp
        local swingY = math.sin(now * 2.7 + 1.4) * swingAmp * 0.7
        local offX = flickX + corrX + swingX
        local offY = flickY + corrY + swingY
        -- eased lean angle for the weapon tilt below (smooth by construction)
        schizoLean = math.clamp((flickX + corrX) / dist0, -0.5, 0.5) * 0.22
        tp = tp + right0 * offX + up0 * offY
    end
    -- (Offset is applied post-lerp below as an exact screen trim.)
    local k = 1
    -- Only apply smoothing if the smoothing toggle is enabled
    if getgenv().AimbotConfig.SmoothEnable then
        local sx = (getgenv().AimbotConfig.SmoothX or 20)
        local sy = (getgenv().AimbotConfig.SmoothY or 20)
        -- rescaled WAY smoother: old 80 now feels like new ~30-35.
        -- 0 = instant, 100 = max smooth (65+ is basically full glue).
        local rawT = math.clamp(((sx + sy) / 2) / 100, 0, 1)
        local t = math.clamp(rawT * 1.55, 0, 1) -- 0 = instant, 1 = max smooth
        local style = string.lower(tostring(getgenv().AimbotConfig.SmoothingStyle or "linear"))
        -- Snappiness (0-2, default 1): global sharpness bias, strongest on
        -- snappy/vanilla. Each style below has its own distinct curve and
        -- all slow down properly at 90+ (low floor so 90 feels smooth).
        local snapAmt = math.clamp(tonumber(getgenv().AimbotConfig.SnapAmount) or 1, 0, 2)
        if style == "linear" then
            -- Even, predictable glide.
            k = 1 - t * 0.985
        elseif style == "lerp" then
            -- Raw constant-fraction tracking, no easing curve.
            k = 1 - t
        elseif style == "smoothdamp" then
            -- Damped settle: quick response with a soft, overshoot-free landing.
            local u = 1 - t
            k = 0.01 + 0.99 * (u ^ 1.5)
        elseif style == "hard snap" then
            -- Instant across the board, only the last stretch of the slider slows.
            local x = math.clamp((t - 0.85) / 0.15, 0, 1)
            local s = x * x * (3 - 2 * x)
            k = 1 - s * 0.99
        elseif style == "exponential" then
            -- Slowest: strong smoothing even at low slider values.
            k = 0.01 + 0.99 * math.exp(-5 * t)
        elseif style == "easeinsine" then
            -- Slow start, accelerating finish.
            k = 1 - (1 - math.cos(t * math.pi / 2)) * 0.985
        elseif style == "easeoutsine" then
            -- Fast start, buttery settle.
            k = 1 - math.sin(t * math.pi / 2) * 0.985
        elseif style == "circ" then
            -- Circular: stays quick through most of the slider, dives
            -- steeply smooth right at the top.
            k = 0.01 + 0.99 * math.sqrt(math.max(0, 1 - t * t))
        elseif style == "flick" then
            -- Flick: near-instant snap with a short settle. Built for
            -- reactive flick shots; raise smoothing to tame the landing.
            k = 1 - (t ^ 6) * 0.99
        elseif style == "custom" then
            -- Custom: YOUR curve. Speed sets the exponent (0 = floaty,
            -- 100 = brutal), pull sets how hard it snaps toward the
            -- point on angle (0 = none, 2 = violent).
            local cs = math.clamp(tonumber(getgenv().AimbotConfig.CustomSpeed) or 50, 0, 100)
            local cp = math.clamp(tonumber(getgenv().AimbotConfig.CustomPull) or 1, 0, 2)
            k = 1 - (t ^ (0.5 + (cs / 100) * 4.5)) * 0.99
            local okA, ang = pcall(function()
                local dir = (tp - cam.CFrame.Position)
                if dir.Magnitude < 0.001 then return 0 end
                return math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir.Unit), -1, 1))
            end)
            if okA and ang then
                local boost = math.clamp(ang / math.rad(28), 0, 1)
                k = k + (1 - k) * (boost ^ 1.5) * (cp * 0.8)
            end
        elseif style == "snappy" then
            -- Snappy: controls how hard the aim snaps toward the target
            -- DIRECTION. Snappiness slider drives it (0 = mild directional
            -- glide, 2 = ultra-aggressive snap). Base stays quick.
            k = 1 - (t ^ 3) * 0.99
            local okA, ang = pcall(function()
                local dir = (tp - cam.CFrame.Position)
                if dir.Magnitude < 0.001 then return 0 end
                return math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir.Unit), -1, 1))
            end)
            if okA and ang then
                local boost = math.clamp(ang / math.rad(25), 0, 1)
                k = k + (1 - k) * (boost ^ 2) * (0.3 + snapAmt * 0.6)
            end
        elseif style == "schizo" then
            -- SCHIZO base: full smoothing-slider authority (0 = instant,
            -- 100 = slow heavy glide) so "smoothness" actually works here.
            -- Flicks still punch through because the tp offset persists
            -- during the hold -- high smooth just makes them laggy/wide
            -- instead of instant, which reads even more unhinged.
            k = 1 - (t ^ 1.6) * 0.985
            k = math.max(k, 0.02)
            local okA, ang = pcall(function()
                local dir = (tp - cam.CFrame.Position)
                if dir.Magnitude < 0.001 then return 0 end
                return math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir.Unit), -1, 1))
            end)
            if okA and ang then
                -- big flicks snap harder (feeds the overshoot-fly-past feel)
                local boost = math.clamp(ang / math.rad(35), 0, 1)
                k = k + (1 - k) * (boost ^ 1.5) * math.clamp(0.5 + snapAmt * 0.3, 0, 1.1)
            end
            -- strafe side-switch: violent lateral chase
            if latNow > 0.15 then
                local glue = math.clamp(0.6 + snapAmt * 0.25, 0, 1.1)
                k = k + (1 - k) * math.clamp(latNow * 1.2, 0, 1) * glue
            end
            -- jump chase: violent vertical tracking
            if airNow > 0.12 then
                local jglue = math.clamp(0.6 + snapAmt * 0.25, 0, 1.1)
                k = k + (1 - k) * math.clamp(airNow * 1.2, 0, 1) * jglue
            end
        elseif style == "vanilla" then
            -- Vanilla: legit look. Smooth base on ground (80 feels smooth
            -- now, not snappy), fast + strong when the target jumps.
            local u = 1 - t
            k = 0.015 + 0.985 * (u ^ 2.6)
            local snapBoost = 0.5 + snapAmt * 0.5
            local okA, ang = pcall(function()
                local dir = (tp - cam.CFrame.Position)
                if dir.Magnitude < 0.001 then return 0 end
                return math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir.Unit), -1, 1))
            end)
            if okA and ang then
                local boost = math.clamp(ang / math.rad(22), 0, 1)
                k = k + (1 - k) * boost * boost * snapBoost
            end
        else
            k = 1 - t * 0.985
        end
        -- Global sharpness bias (subtle on normal styles; vanilla/snappy/
        -- schizo handle snapAmt themselves, so skip them here).
        if style ~= "vanilla" and style ~= "snappy" and style ~= "schizo" then
            k = k + (1 - k) * (snapAmt - 1) * 0.12
        end
        if style == "vanilla" then
            -- Ground = smooth base above. Airborne = speed up hard toward
            -- the side they're moving (airNow shared with prediction above).
            if airNow > 0 then
                local jumpMix = 0.55 + snapAmt * 0.2 -- snap 0->0.55, 1->0.75, 2->0.95
                k = k + (1 - k) * airNow * jumpMix
            end
        end
        if getgenv().AimbotConfig.PredEnable then
            -- Prediction slider doubles as responsiveness (INVERTED):
            -- 0 = max prediction = tight follow (barely any added smoothing),
            -- 20 = min prediction = heavy added smoothing.
            local damp = (style == "schizo") and 0.4 or 0.35 -- Increased to respect smoothing slider even more
            k = k * (1 - (1 - predScale) * damp)
        end
        k = math.clamp(k, 0.01, 1)
    end
    local cf = cam.CFrame
    local aimMethod = string.lower(tostring(getgenv().AimbotConfig.Method or "camera"))
    local thirdSnap = (aimMethod == "mouse 3rd person")
    local useMouse = (aimMethod == "mouse" or thirdSnap) and (typeof(mousemoverel) == "function")
    if useMouse then
        local okS, sp = pcall(function() return cam:WorldToViewportPoint(tp) end)
        if okS and sp then
            local res = GuiService:GetScreenResolution()
            local mdx, mdy = sp.X - res.X / 2, sp.Y - res.Y / 2
            if getgenv().AimbotConfig.OffsetEnable then
                mdx = mdx + (getgenv().AimbotConfig.OffsetX or 0)
                mdy = mdy + (getgenv().AimbotConfig.OffsetY or 0)
            end
            if getgenv().AimbotConfig.AirOffsetEnable and airNow > 0.12 then
                mdx = mdx + (getgenv().AimbotConfig.AirOffsetX or 0)
                mdy = mdy + (getgenv().AimbotConfig.AirOffsetY or 0)
            end
            -- schizo on mouse: the tp overflick above already throws the
            -- cursor past the target; nothing extra here (any per-frame
            -- noise here reads as vibration, so none is added).
            local f = thirdSnap and 1 or math.clamp(k * dt * 60, 0, 1)
            pcall(mousemoverel, mdx * f, mdy * f)
        end
    else
        cam.CFrame = cf:Lerp(CFrame.new(cf.Position, tp), math.clamp(k * dt * 60, 0, 1))
        -- SCHIZO weapon feel: the chaos (overflicks flying past the target)
        -- is baked into tp above. This is ONLY a smooth lean that follows
        -- the eased flick offset plus a faint slow sway -- no steps, no
        -- fast sines, no randomness, so it can never vibrate.
        if styleNow == "schizo" then
            local tm = os.clock()
            local tilt = schizoLean + math.sin(tm * 1.8) * 0.008
            local bobX = math.sin(tm * 1.6) * 0.03
            local bobY = math.sin(tm * 1.9 + 0.7) * 0.03
            pcall(function()
                cam.CFrame = cam.CFrame
                    * CFrame.Angles(0, 0, tilt)
                    * CFrame.new(bobX, bobY, 0)
            end)
        end
    end
    -- Offset: exact screen-space trim AFTER smoothing, identical on every
    -- smoothing style and never swallowed by heavy smoothing. (A positional
    -- tp offset behaved differently per style and camera angle.)
    if (not useMouse) and getgenv().AimbotConfig.OffsetEnable then
        local ox = (getgenv().AimbotConfig.OffsetX or 0) / 100
        local oy = (getgenv().AimbotConfig.OffsetY or 0) / 100
        if ox ~= 0 or oy ~= 0 then
            local okO, dist = pcall(function() return (tp - cam.CFrame.Position).Magnitude end)
            if okO and typeof(dist) == "number" and dist > 0.5 then
                cam.CFrame = cam.CFrame * CFrame.Angles(oy / dist, -ox / dist, 0)
            end
        end
    end
    -- Air offset: same screen-space trim as offset above, but ONLY while the
    -- locked target is airborne (jump/fall). Stacks on top of ground offset.
    if (not useMouse) and getgenv().AimbotConfig.AirOffsetEnable then
        local ax = (getgenv().AimbotConfig.AirOffsetX or 0) / 100
        local ay = (getgenv().AimbotConfig.AirOffsetY or 0) / 100
        if (ax ~= 0 or ay ~= 0) and airNow > 0.12 then
            local okA2, dist2 = pcall(function() return (tp - cam.CFrame.Position).Magnitude end)
            if okA2 and typeof(dist2) == "number" and dist2 > 0.5 then
                cam.CFrame = cam.CFrame * CFrame.Angles(ay / dist2, -ax / dist2, 0)
            end
        end
    end
end)

