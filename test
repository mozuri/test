                        a[5], a[6], a[7] = aimPos, part, Vector3.new(0, 1, 0)
                    end
                    -- Explicit forward: unpack(a) truncates at nil-holes, and
                    -- shotgun args HAVE holes (PelletData,nil,nil,nil,Range,
                    -- Damage), silently dropping Range/Damage = 0 damage.
                    -- Revolver's hole pattern survived, which is exactly why
                    -- only DB/Tac broke. Explicit nils pass through fine.
                    return OldNC(self, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11], a[12])
                end
            end
        end
        return OldNC(self, ...)
    end)) or function(self, ...) return OldNC(self, ...) end)
    warn("Silent aim: MainRemoteEvent ShootGun hook installed")
end)

