                    obj.Color = ColorSequence.new(kc)
                else
                    obj.Color = kc
                end
            end)
        end
    end
    local isBulletPart = false
    if not isBeam and not isTrail and obj:IsA("BasePart") then
        local n = obj.Name:lower()
        if n:find("bullet") or n:find("tracer") or n:find("pellet") or n:find("projectile") or n == "shot" then
            isBulletPart = true
        else
            if not isKnifeFx then return end
        end
    elseif not isBeam and not isTrail and not isKnifeFx then
        return
    end
    do
        local tool0, skin0 = equippedSkinnedGun()
        if (not tool0 or not skin0) and lastShot.tool and lastShot.skin ~= "" then
            if os.clock() - lastShot.t < 0.6 then
                tool0, skin0 = lastShot.tool, lastShot.skin
            end
        end
        if tool0 and skin0 and getCustomDef(tool0.Name, skin0) then
            if isBulletPart then
                pcall(function() obj.Color = gunBulletColor(tool0, skin0) end)
            else
                paintBeam(obj, tool0, skin0)
            end
        end
    end
end)

-- Tool wiring for custom skins
local function setupCustomTool(tool)
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then return end
    local okAttr = pcall(function() return tool:GetAttribute("CustomSetup") end)
    if not okAttr then return end
    if tool:GetAttribute("CustomSetup") then return end
    pcall(function() tool:SetAttribute("CustomSetup", true) end)
    
    tool.Activated:Connect(function()
        local skin = tool:GetAttribute("CustomSkin")
        if skin and skin ~= "" and skin ~= "Default" and skin ~= "None" then
            lastShot.t = os.clock()
            lastShot.tool = tool
            lastShot.skin = skin
        end
    end)
    
    tool.Equipped:Connect(function()
        task.wait(0.05)
        if tool.Parent ~= LocalPlayer.Character then return end
        
        -- Check if custom skins are enabled
        if not getgenv().CustomSkins.Enable then return end
        
        -- Map tool names to config keys
        local skinName = nil
        if tool.Name == "[Double-Barrel SG]" then
            skinName = getgenv().CustomSkins.DB
        elseif tool.Name == "[Revolver]" then
            skinName = getgenv().CustomSkins.Rev
        elseif tool.Name == "[TacticalShotgun]" then
            skinName = getgenv().CustomSkins.Tac
        end
        
        if not skinName or skinName == "None" or skinName == "" then
            cleanCustomGun(tool)
            return
        end
        
        applyCustomGun(tool, skinName)
    end)
    
    tool.Unequipped:Connect(function()
        -- Custom skins cleanup is handled by the state management
    end)
    
    if tool.Parent == LocalPlayer.Character then
        task.spawn(function()
            if not getgenv().CustomSkins.Enable then return end
            
            local skinName = nil
            if tool.Name == "[Double-Barrel SG]" then
                skinName = getgenv().CustomSkins.DB
            elseif tool.Name == "[Revolver]" then
                skinName = getgenv().CustomSkins.Rev
            elseif tool.Name == "[TacticalShotgun]" then
                skinName = getgenv().CustomSkins.Tac
            end
            
            if skinName and skinName ~= "None" and skinName ~= "" then
                applyCustomGun(tool, skinName)
            end
        end)
    end
end

